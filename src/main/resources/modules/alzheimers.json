{
  "name": "Alzheimers Disease Module",
  "remarks": [
    "Comprehensive Alzheimer's disease simulation from preclinical to end-stage",
    "Includes cognitive decline, functional impairment, and behavioral symptoms",
    "Models diagnosis, treatment, caregiver burden, and advanced care planning"
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "MedicareMaturationDelay"
    },
    "MedicareMaturationDelay": {
      "type": "Delay",
      "range": {
        "low": 0,
        "high": 1825,
        "unit": "days"
      },
      "direct_transition": "PreclinicalPhase"
    },
    "PreclinicalPhase": {
      "type": "Delay",
      "range": {
        "low": 2,
        "high": 10,
        "unit": "years"
      },
      "direct_transition": "MildCognitiveImpairment"
    },
    "MildCognitiveImpairment": {
      "type": "ConditionOnset",
      "assign_to_attribute": "cognitive_status",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "386805003",
          "display": "Cognitive impairment (finding)"
        },
        {
          "system": "SNOMED-CT",
          "code": "192071009",
          "display": "Mild cognitive impairment, so stated"
        }
      ],
      "direct_transition": "MCI_MoCA"
    },
    "MCI_MoCA": {
      "type": "Observation",
      "category": "exam",
      "codes": [
        {
          "system": "LOINC",
          "code": "72172-0",
          "display": "Montreal Cognitive Assessment total score"
        }
      ],
      "value": {
        "type": "Range",
        "low": 18,
        "high": 25,
        "unit": "points"
      },
      "direct_transition": "Memory_Impairment"
    },
    "End_MCI_Encounter": {
      "type": "EncounterEnd",
      "direct_transition": "AmyloidEligibilityAssessment"
    },
    "Memory_Impairment": {
      "type": "Symptom",
      "symptom": "Memory impairment",
      "range": {
        "low": 40,
        "high": 70
      },
      "direct_transition": "PrimaryCareVisit_MCI"
    },
    "PrimaryCareVisit_MCI": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185347001",
          "display": "Encounter for problem (procedure)"
        }
      ],
      "direct_transition": "MCI_Cognitive_Assessment"
    },
    "MCI_Cognitive_Assessment": {
      "type": "Procedure",
      "codes": [
        {
          "system": "CPT",
          "code": "99483",
          "display": "Cognitive assessment and care plan services"
        }
      ],
      "direct_transition": "BrainMRI"
    },
    "BrainMRI": {
      "type": "Procedure",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "113091000",
          "display": "Magnetic resonance imaging of brain"
        }
      ],
      "direct_transition": "End_MCI_Encounter"
    },
    "AmyloidEligibilityAssessment": {
      "type": "Simple",
      "distributed_transition": [
        {
          "distribution": 0.85,
          "transition": "MCIProgression"
        },
        {
          "distribution": 0.15,
          "transition": "ChooseBiologicTherapy"
        }
      ]
    },
    "ChooseBiologicTherapy": {
      "type": "Simple",
      "distributed_transition": [
        {
          "distribution": 0.6,
          "transition": "StartLecanemab"
        },
        {
          "distribution": 0.4,
          "transition": "StartDonanemab"
        }
      ]
    },
    "StartLecanemab": {
      "type": "MedicationOrder",
      "administration": true,
      "codes": [
        {
          "system": "RxNorm",
          "code": "2626143",
          "display": "lecanemab"
        }
      ],
      "reason": "alzheimers_disease",
      "direct_transition": "InfusionProgram"
    },
    "FallAdmission": {
      "type": "Encounter",
      "encounter_class": "inpatient",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185347001",
