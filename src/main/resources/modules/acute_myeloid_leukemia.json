{
  "name": "Acute Myeloid Leukemia",
  "remarks": [
    "This module simulates the progression of Acute Myeloid Leukemia (AML) from onset through treatment phases.",
    "Models age-dependent subtypes, genetic mutations, and treatment responses.",
    "Based on WHO classification, ELN risk stratification, and modern treatment protocols."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Initial_Delay"
    },
    "Age_Risk_Assessment": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 18,
            "unit": "years"
          },
          "transition": "Pediatric_AML_Risk"
        },
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Age",
                "operator": ">=",
                "quantity": 18,
                "unit": "years"
              },
              {
                "condition_type": "Age",
                "operator": "<",
                "quantity": 60,
                "unit": "years"
              }
            ]
          },
          "transition": "Young_Adult_AML_Risk"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 60,
            "unit": "years"
          },
          "transition": "Older_Adult_AML_Risk"
        },
        {
          "transition": "Older_Adult_AML_Risk"
        }
      ]
    },
    "Pediatric_AML_Risk": {
      "type": "SetAttribute",
      "attribute": "aml_patient_type",
      "value": "pediatric",
      "distributed_transition": [
        {
          "transition": "Normal_Hematologic_Health",
          "distribution": 0.99998
        },
        {
          "transition": "Congenital_AML_Risk",
          "distribution": 2e-05
        }
      ]
    },
    "Young_Adult_AML_Risk": {
      "type": "SetAttribute",
      "attribute": "aml_patient_type",
      "value": "young_adult",
      "distributed_transition": [
        {
          "transition": "Normal_Hematologic_Health",
          "distribution": 0.99995
        },
        {
          "transition": "Secondary_AML_Risk",
          "distribution": 3e-05
        },
        {
          "transition": "De_Novo_AML_Risk",
          "distribution": 2e-05
        }
      ]
    },
    "Older_Adult_AML_Risk": {
      "type": "SetAttribute",
      "attribute": "aml_patient_type",
      "value": "older_adult",
      "distributed_transition": [
        {
          "transition": "Normal_Hematologic_Health",
          "distribution": 0.9996
        },
        {
          "transition": "Secondary_AML_Risk",
          "distribution": 0.00025
        },
        {
          "transition": "De_Novo_AML_Risk",
          "distribution": 0.00015
        }
      ]
    },
    "AML_Condition": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "91861009",
          "display": "Acute myeloid leukemia"
        }
      ],
      "direct_transition": "AML_Diagnosis",
      "assign_to_attribute": "acute_myeloid_leukemia"
    },
    "Normal_Hematologic_Health": {
      "type": "SetAttribute",
      "attribute": "aml_stage",
      "value": 0,
      "direct_transition": "AML_Development_Monitoring"
    },
    "AML_Development_Monitoring": {
      "type": "Delay",
      "range": {
        "low": 3,
        "high": 12,
        "unit": "months"
      },
      "complex_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "aml_patient_type",
                "operator": "==",
                "value": "pediatric"
              },
              {
                "condition_type": "Attribute",
                "attribute": "aml_stage",
                "operator": "==",
                "value": 0
              }
            ]
          },
          "distributions": [
            {
              "distribution": 0.99998,
              "transition": "AML_Development_Monitoring"
            },
            {
              "distribution": 2e-05,
              "transition": "Set_Pediatric_AML"
            }
          ]
        },
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "aml_patient_type",
                "operator": "==",
                "value": "young_adult"
              },
              {
                "condition_type": "Attribute",
                "attribute": "aml_stage",
                "operator": "==",
                "value": 0
              }
            ]
          },
          "distributions": [
            {
              "distribution": 0.99995,
              "transition": "AML_Development_Monitoring"
            },
            {
              "distribution": 5e-05,
              "transition": "Set_Young_Adult_AML"
            }
          ]
        },
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "aml_patient_type",
                "operator": "==",
                "value": "older_adult"
              },
              {
                "condition_type": "Attribute",
                "attribute": "aml_stage",
                "operator": "==",
                "value": 0
              }
            ]
          },
          "distributions": [
            {
              "distribution": 0.9996,
              "transition": "AML_Development_Monitoring"
            },
            {
              "distribution": 0.0004,
              "transition": "Set_Older_Adult_AML"
            }
          ]
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "aml_stage",
            "operator": "==",
            "value": 1
          },
          "transition": "Rapid_AML_Progression"
        },
        {
          "transition": "Rapid_AML_Progression"
        }
      ]
    },
    "Congenital_AML_Risk": {
      "type": "SetAttribute",
      "attribute": "congenital_aml",
      "value": true,
      "direct_transition": "Set_High_Risk_AML"
    },
    "Secondary_AML_Risk": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "myelodysplastic_syndrome",
                "operator": "is not nil"
              },
              {
                "condition_type": "Attribute",
                "attribute": "chemotherapy_history",
                "operator": "is not nil"
              },
              {
                "condition_type": "Attribute",
                "attribute": "radiation_exposure",
                "operator": "is not nil"
              }
            ]
          },
          "transition": "Set_Secondary_AML"
        },
        {
          "transition": "Set_De_Novo_AML"
        }
      ]
    },
    "De_Novo_AML_Risk": {
      "type": "SetAttribute",
      "attribute": "de_novo_aml",
      "value": true,
      "direct_transition": "Set_De_Novo_AML"
    },
    "Set_Pediatric_AML": {
      "type": "SetAttribute",
      "attribute": "aml_stage",
      "value": 1,
      "direct_transition": "AML_Condition"
    },
    "Set_Young_Adult_AML": {
      "type": "SetAttribute",
      "attribute": "aml_stage",
      "value": 1,
      "direct_transition": "AML_Condition"
    },
    "Set_Older_Adult_AML": {
      "type": "SetAttribute",
      "attribute": "aml_stage",
      "value": 1,
      "direct_transition": "AML_Condition"
    },
    "Set_Secondary_AML": {
      "type": "SetAttribute",
      "attribute": "aml_stage",
      "value": 1,
      "direct_transition": "AML_Condition"
    },
    "Set_De_Novo_AML": {
      "type": "SetAttribute",
      "attribute": "aml_stage",
      "value": 1,
      "direct_transition": "AML_Condition"
    },
    "Set_High_Risk_AML": {
      "type": "SetAttribute",
      "attribute": "aml_risk",
      "value": "high",
      "direct_transition": "AML_Condition"
    },
    "AML_Diagnosis": {
      "type": "Encounter",
      "encounter_class": "inpatient",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "32485007",
          "display": "Hospital admission"
        }
      ],
      "reason": "Acute Myeloid Leukemia",
      "direct_transition": "Bone_Marrow_Biopsy"
    },
    "AML_Treatment_Pathway": {
      "type": "Simple",
      "distributed_transition": [
        {
          "transition": "Induction_Chemotherapy",
          "distribution": 0.85
        },
        {
          "transition": "Targeted_Therapy",
          "distribution": 0.1
        },
        {
          "transition": "Supportive_Care",
          "distribution": 0.05
        }
      ]
    },
    "Induction_Chemotherapy": {
      "type": "Simple",
      "direct_transition": "Azacitidine_Administration"
    },
    "Azacitidine_Administration": {
      "type": "MedicationOrder",
      "reason": "acute_myeloid_leukemia",
      "administration": true,
      "codes": [
        {
          "system": "RxNorm",
          "code": "1726497",
          "display": "azacitidine Injection"
        }
      ],
      "direct_transition": "Transfusion_Support"
    },
    "Initialize_AML_Monitor_Count": {
      "type": "SetAttribute",
      "attribute": "aml_monitor_count",
      "value": 0,
      "direct_transition": "Venetoclax_Therapy"
    },
    "Increment_AML_Monitor_Count": {
      "type": "Counter",
      "attribute": "aml_monitor_count",
      "action": "increment",
      "direct_transition": "AML_Cycle_Check"
    },
    "AML_Cycle_Check": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "aml_monitor_count",
            "operator": ">=",
            "value": 3
          },
          "transition": "Response_Assessment"
        },
        {
          "transition": "Monthly_AML_Monitoring"
        }
      ]
    },
    "Venetoclax_Therapy": {
      "type": "MedicationOrder",
      "reason": "acute_myeloid_leukemia",
      "assign_to_attribute": "venetoclax_therapy",
      "chronic": true,
      "codes": [
        {
          "system": "RxNorm",
          "code": "1747567",
          "display": "Venetoclax Oral Tablet"
        }
      ],
      "prescription": {
        "dosage": {
          "amount": 1,
          "frequency": 1,
          "period": 1,
          "unit": "days"
        },
        "duration": {
          "quantity": 28,
          "unit": "days"
        }
      },
      "direct_transition": "Monthly_AML_Monitoring"
    },
    "Monthly_AML_Monitoring": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for symptom"
        }
      ],
      "direct_transition": "AML_CBC_Check"
    },
    "AML_CBC_Check": {
      "type": "Observation",
      "category": "laboratory",
      "unit": "10*3/uL",
      "codes": [
        {
          "system": "LOINC",
          "code": "6690-2",
          "display": "Leukocytes [#/volume] in Blood"
        }
      ],
      "range": {
        "low": 1,
        "high": 50
      },
      "direct_transition": "Monthly_AML_Monitoring_End"
    },
    "Monthly_AML_Monitoring_End": {
      "type": "EncounterEnd",
      "direct_transition": "Increment_AML_Monitor_Count"
    },
    "Targeted_Therapy": {
      "type": "Simple",
      "direct_transition": "Initialize_AML_Monitor_Count"
    },
    "Supportive_Care": {
      "type": "Procedure",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "133918004",
          "display": "Supportive care"
        }
      ],
      "direct_transition": "Response_Assessment"
    },
    "Response_Assessment": {
      "type": "Simple",
      "distributed_transition": [
        {
          "transition": "Complete_Remission",
          "distribution": 0.6
        },
        {
          "transition": "Partial_Remission",
          "distribution": 0.2
        },
        {
          "transition": "Relapsed_AML",
          "distribution": 0.2
        }
      ]
    },
    "Complete_Remission": {
      "type": "SetAttribute",
      "attribute": "aml_status",
      "value": "remission",
      "direct_transition": "Venetoclax_End"
    },
    "Partial_Remission": {
      "type": "SetAttribute",
      "attribute": "aml_status",
      "value": "partial_remission",
      "direct_transition": "Relapsed_AML"
    },
    "Relapsed_AML": {
      "type": "SetAttribute",
      "attribute": "aml_status",
      "value": "relapsed",
      "direct_transition": "Salvage_Therapy"
    },
    "Salvage_Therapy": {
      "type": "Simple",
      "direct_transition": "Relapsed_Venetoclax_Therapy"
    },
    "Relapsed_Venetoclax_Therapy": {
      "type": "MedicationOrder",
      "reason": "relapsed_acute_myeloid_leukemia",
      "assign_to_attribute": "relapsed_venetoclax",
      "chronic": true,
      "codes": [
        {
          "system": "RxNorm",
          "code": "1747567",
          "display": "Venetoclax Oral Tablet"
        }
      ],
      "prescription": {
        "dosage": {
          "amount": 1,
          "frequency": 1,
          "period": 1,
          "unit": "days"
        },
        "duration": {
          "quantity": 28,
          "unit": "days"
        }
      },
      "direct_transition": "Relapsed_Venetoclax_End"
    },
    "Transfusion_Support": {
      "type": "Procedure",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "116859006",
          "display": "Transfusion of blood product"
        }
      ],
      "direct_transition": "AML_Diagnosis_End"
    },
    "Surveillance": {
      "type": "Delay",
      "range": {
        "low": 3,
        "high": 12,
        "unit": "months"
      },
      "distributed_transition": [
        {
          "transition": "Relapsed_AML",
          "distribution": 0.2
        },
        {
          "transition": "Surveillance",
          "distribution": 0.8
        }
      ]
    },
    "Rapid_AML_Progression": {
      "type": "Death",
      "direct_transition": "Final_Delay"
    },
    "Terminal": {
      "type": "Terminal"
    },
    "AML_Diagnosis_End": {
      "type": "EncounterEnd",
      "direct_transition": "AML_Treatment_Pathway"
    },
    "Initial_Delay": {
      "type": "Delay",
      "range": {
        "low": 365,
        "high": 3650,
        "unit": "days"
      },
      "direct_transition": "Age_Risk_Assessment"
    },
    "Bone_Marrow_Biopsy": {
      "type": "Procedure",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "86273004",
          "display": "Bone marrow biopsy"
        }
      ],
      "direct_transition": "AML_Diagnostic_Report"
    },
    "AML_Diagnostic_Report": {
      "type": "DiagnosticReport",
      "codes": [
        {
          "system": "LOINC",
          "code": "58410-2",
          "display": "Bone marrow study"
        }
      ],
      "observations": [
        {
          "category": "laboratory",
          "codes": [
            {
              "system": "LOINC",
              "code": "30376-8",
              "display": "Blasts"
            }
          ]
        }
      ],
      "direct_transition": "Azacitidine_Administration"
    },
    "Venetoclax_End": {
      "type": "MedicationEnd",
      "referenced_by_attribute": "venetoclax_therapy",
      "direct_transition": "Surveillance"
    },
    "Relapsed_Venetoclax_End": {
      "type": "MedicationEnd",
      "referenced_by_attribute": "relapsed_venetoclax",
      "direct_transition": "Response_Assessment"
    },
    "Final_Delay": {
      "type": "Delay",
      "range": {
        "low": 365,
        "high": 365,
        "unit": "days"
      },
      "direct_transition": "Terminal"
    }
  },
  "gmf_version": 1
}
