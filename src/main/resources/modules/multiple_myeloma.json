{
  "name": "Multiple Myeloma Claims Realistic",
  "remarks": [
    "Merged disease-natural-history and claims-utilization multiple myeloma module",
    "Preserves MGUS \u2192 smoldering \u2192 active MM progression",
    "Adds Medicare oncology utilization realism for BB2 RIF generation"
