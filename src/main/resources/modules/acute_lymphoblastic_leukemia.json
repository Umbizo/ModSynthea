      "value": "B_cell",
      "direct_transition": "Early_ALL_Symptoms"
    },
    "Set_ALL_Subtype_T": {
      "type": "SetAttribute",
      "attribute": "all_subtype",
      "value": "T_cell",
      "direct_transition": "Early_ALL_Symptoms"
    },
    "Set_ALL_Subtype_High_Risk": {
      "type": "SetAttribute",
      "attribute": "all_subtype",
      "value": "high_risk",
      "direct_transition": "Severe_ALL_Symptoms"
    },
    "Set_ALL_Subtype_Secondary": {
      "type": "SetAttribute",
      "attribute": "all_subtype",
      "value": "secondary",
      "direct_transition": "Severe_ALL_Symptoms"
    },
