        "unit": "days"
      },
      "direct_transition": "EndStageComplications"
    },
    "EndStage_Mortality_Check": {
      "type": "Delay",
      "remarks": [
        "Task 1.6 containment fix: the module previously had no Death state at",
        "all on the AD path -- LongTermCareConsideration/AdvancedDiseaseFollowup",
        "/EndStageComplications formed a closed loop with no exit but",
        "RevertToNormal (pre-AD only). 0.45/yr approximates advanced-dementia",
        "mortality once a patient has reached long-term-care/hospice-eligible",
        "status (Mitchell ES et al., 'The Clinical Course of Advanced",
        "Dementia', NEJM 2009;361:1529-38: median survival ~1.3 years, ~25%",
        "six-month mortality, after meeting advanced-dementia criteria similar",
        "to this loop's entry population). Combined with the module's own",
        "expected mild+moderate transit time (~5 years across the annual",
        "review loops before reaching this arm), this lands the model's",
        "overall post-diagnosis survival in the same range as the Alzheimer's",
        "Association's commonly cited 4-8 year figure -- a calibration",
        "approximation, not a literature-exact replication, per the fix brief.",
        "No encounter is open when this state is reached (verified: every",
        "inbound path into EndStageComplications closes its own encounter",
        "first), so Death needs no separate close-the-visit state here."
      ],
      "range": {
        "low": 335,
        "high": 395,
        "unit": "days"
      },
      "distributed_transition": [
        {
          "distribution": 0.45,
          "transition": "Death_From_Alzheimers"
        },
        {
          "distribution": 0.55,
          "transition": "AdvancedDiseaseFollowup"
        }
      ]
    },
    "Death_From_Alzheimers": {
      "type": "Death",
      "condition_onset": "MildDementia",
      "direct_transition": "Terminal"
    },
