{
  "name": "Acute Lymphoblastic Leukemia",
  "remarks": [
    "This module simulates the progression of Acute Lymphoblastic Leukemia (ALL) from onset through treatment phases.",
    "Models adult ALL with prognoses and treatment responses.",
    "Based on WHO classification and clinical treatment protocols.",
    "NOTE: Precursor B/T cell refers to the developmental stage of lymphocytes and is indicative of acute leukemia, not incomplete or developing leukemia."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Initial_Delay"
    },
    "Age_Risk_Assessment": {
      "type": "Simple",
      "distributed_transition": [
        {
          "transition": "Normal_Hematologic_Health",
          "distribution": 0.99995
        },
        {
          "transition": "Secondary_ALL_Risk",
          "distribution": 3e-05
        },
        {
          "transition": "Genetic_Predisposition",
          "distribution": 2e-05
        }
      ]
    },
    "Normal_Hematologic_Health": {
      "type": "SetAttribute",
      "attribute": "all_stage",
      "value": 0,
      "direct_transition": "ALL_Development_Monitoring"
    },
    "ALL_Development_Monitoring": {
      "type": "Delay",
      "range": {
        "low": 340,
        "high": 390,
        "unit": "days"
      },
      "remarks": [
        "One sporadic-ALL incidence roll per year of life; see ALL_Incidence_Hazard_Check for the age-banded rates.",
        "Previously rolled a flat 5e-5 chance every 6-12 months for the rest of the person's life with no age adjustment -- that let sporadic risk compound unrealistically into old age (~5x over SEER, elderly-skewed instead of the true early-childhood peak)."
      ],
      "direct_transition": "ALL_Incidence_Hazard_Check"
    },
    "ALL_Incidence_Hazard_Check": {
      "type": "Simple",
      "remarks": [
        "Age-banded annual sporadic ALL hazard (SEER childhood cancer statistics: incidence peaks ages 1-4, falls through childhood, low flat rate in adults):",
        "  ages 1-4:  7e-5/year",
        "  ages 5-14: 3e-5/year",
        "  ages 15+:  1e-5/year",
        "p_pass = 1 - (1 - p_annual)^(delta t years); delta t = 1 year here, so p_pass = p_annual directly.",
        "Branch order matters: complex_transition takes the first true condition, so the youngest band is tested first."
      ],
      "complex_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Age",
                "operator": ">=",
                "quantity": 1,
                "unit": "years"
              },
              {
                "condition_type": "Age",
                "operator": "<=",
                "quantity": 4,
                "unit": "years"
              }
            ]
          },
          "distributions": [
            {
              "transition": "Set_Precursor_B_ALL",
              "distribution": 7e-05
            },
            {
              "transition": "ALL_Development_Monitoring",
              "distribution": 0.99993
            }
          ]
        },
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Age",
                "operator": ">=",
                "quantity": 5,
                "unit": "years"
              },
              {
                "condition_type": "Age",
                "operator": "<=",
                "quantity": 14,
                "unit": "years"
              }
            ]
          },
          "distributions": [
            {
              "transition": "Set_Precursor_B_ALL",
              "distribution": 3e-05
            },
            {
              "transition": "ALL_Development_Monitoring",
              "distribution": 0.99997
            }
          ]
        },
        {
          "distributions": [
            {
              "transition": "Set_Precursor_B_ALL",
              "distribution": 1e-05
            },
            {
              "transition": "ALL_Development_Monitoring",
              "distribution": 0.99999
            }
          ]
        }
      ]
    },
    "Genetic_Predisposition": {
      "type": "SetAttribute",
      "attribute": "genetic_all",
      "value": true,
      "direct_transition": "Set_High_Risk_ALL",
      "remarks": [
        "Genetic syndromes: Down syndrome, Li-Fraumeni, etc.",
        "Higher risk and often worse prognosis"
      ]
    },
    "Secondary_ALL_Risk": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "cancer_history",
                "operator": "is not nil"
              },
              {
                "condition_type": "Attribute",
                "attribute": "radiation_exposure",
                "operator": "is not nil"
              },
              {
                "condition_type": "Attribute",
                "attribute": "chemotherapy_history",
                "operator": "is not nil"
              }
            ]
          },
          "transition": "Set_Secondary_ALL"
        },
        {
          "transition": "Set_Precursor_B_ALL"
        }
      ],
      "remarks": [
        "Secondary ALL from prior chemotherapy/radiation",
        "Treatment-related leukemia"
      ]
    },
    "Set_Precursor_B_ALL": {
      "type": "SetAttribute",
      "attribute": "all_stage",
      "value": 1,
      "distributed_transition": [
        {
          "transition": "B_Cell_ALL_Onset",
          "distribution": 0.85
        },
        {
          "transition": "T_Cell_ALL_Onset",
          "distribution": 0.15
        }
      ],
      "remarks": [
        "85% of ALL cases are B-cell lineage",
        "15% are T-cell lineage",
        "Precursor refers to developmental stage of B/T cells - this is mature acute leukemia"
      ]
    },
    "Set_High_Risk_ALL": {
      "type": "SetAttribute",
      "attribute": "all_stage",
      "value": 1,
      "direct_transition": "High_Risk_ALL_Onset"
    },
    "Set_Secondary_ALL": {
      "type": "SetAttribute",
      "attribute": "all_stage",
      "value": 1,
      "direct_transition": "Secondary_ALL_Onset"
    },
    "B_Cell_ALL_Onset": {
      "type": "ConditionOnset",
      "remarks": [
        "CORRECTED: 277572005 fails the SNOMED CT Verhoeff check digit (off-by-one typo). 277572006 'Precursor B-cell acute lymphoblastic leukaemia' verified active via SNOMED CT $lookup."
      ],
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "277572006",
          "display": "Precursor B-cell acute lymphoblastic leukemia (disorder)"
        }
      ],
      "direct_transition": "Set_ALL_Subtype_B"
    },
    "T_Cell_ALL_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "277575008",
          "display": "Precursor T-cell lymphoblastic leukemia (disorder)"
        }
      ],
      "direct_transition": "Set_ALL_Subtype_T"
    },
    "High_Risk_ALL_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "91857003",
          "display": "Acute lymphoblastic leukemia (disorder)"
        }
      ],
      "direct_transition": "Set_ALL_Subtype_High_Risk"
    },
    "Secondary_ALL_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "109995007",
          "display": "Secondary malignant neoplasm (disorder)"
        }
      ],
      "direct_transition": "Set_ALL_Subtype_Secondary"
    },
    "Set_ALL_Subtype_B": {
      "type": "SetAttribute",
