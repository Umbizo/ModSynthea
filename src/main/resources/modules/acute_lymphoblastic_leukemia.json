    },
    "Response_Assessment": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 18,
            "unit": "years"
          },
          "transition": "Pediatric_Treatment_Response"
        },
        {
          "transition": "Adult_Treatment_Response"
        }
      ]
    },
    "ALL_Monitoring_End": {
      "type": "EncounterEnd",
      "direct_transition": "Response_Assessment"
    },
    "Maintenance_Mercaptopurine": {
