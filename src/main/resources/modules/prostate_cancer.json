            },
            {
              "transition": "End_Visit_For_Radiation",
              "distribution": 0.3
            }
          ]
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "prostate_cancer_risk",
            "operator": "==",
            "value": "unfavorable_intermediate"
          },
          "distributions": [
            {
              "transition": "End_Visit_For_Surgery",
              "distribution": 0.4
            },
            {
              "transition": "End_Visit_For_Radiation",
              "distribution": 0.4
            },
            {
              "transition": "Start_ADT_Combined_Modality",
              "distribution": 0.2
            }
          ]
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "prostate_cancer_risk",
            "operator": "==",
            "value": "high_risk"
          },
          "distributions": [
            {
              "transition": "Start_ADT_Combined_Modality",
              "distribution": 0.6
            },
            {
              "transition": "End_Visit_For_Surgery",
              "distribution": 0.3
            },
            {
              "transition": "End_Visit_For_Radiation",
              "distribution": 0.1
            }
          ]
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "prostate_cancer_risk",
            "operator": "==",
            "value": "very_high_risk"
          },
          "distributions": [
            {
              "transition": "Start_ADT_Systemic",
              "distribution": 0.7
            },
            {
              "transition": "Start_ADT_Combined_Modality",
              "distribution": 0.3
            }
          ]
        },
        {
          "transition": "Active_Surveillance"
        }
      ]
    },
    "Active_Surveillance": {
      "type": "CarePlanStart",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "712837004",
          "display": "Prostate cancer surveillance"
        }
      ],
      "reason": "Prostate Cancer",
      "direct_transition": "End_Treatment_Visit"
    },
    "End_Treatment_Visit": {
      "type": "EncounterEnd",
      "direct_transition": "Surveillance_Monitoring"
    },
    "Start_ADT_Combined_Modality": {
      "type": "MedicationOrder",
      "remarks": [
