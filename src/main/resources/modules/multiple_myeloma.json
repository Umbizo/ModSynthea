          "transition": "CRAB_Check_Encounter_End",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "mm_ckd",
            "operator": "is not nil"
          }
        },
        {
          "transition": "Renal_Failure"
        }
      ]
    },
    "Bone_Disease_Check": {
