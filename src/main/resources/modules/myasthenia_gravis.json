    "End_Myasthenic_Crisis": {
      "type": "ConditionEnd",
      "condition_onset": "Myasthenic_Crisis_Onset",
      "remarks": [
        "Fix round 1: Myasthenic_Crisis_Onset previously had no matching",
        "close anywhere in the module, so a patient surviving multiple",
        "crises over the Long_Term_Outcome loop's lifetime span (a realistic",
        "~8 episodes under the round-0 rate, still several under the",
        "corrected rate) stacked that many simultaneously 'active' crisis",
        "conditions. A myasthenic crisis is an acute, self-limited (if",
        "severe) episode that resolves with treatment over days to weeks --",
        "unlike the underlying chronic MG diagnosis, it should not persist",
        "as active once the patient stabilises."
      ],
      "direct_transition": "Follow_Up_3_Months"
