{
  "name": "Rheumatoid_Arthritis",
  "gmf_version": 2,
  "remarks": [
    "RA module integrating incidence, symptom onset, lab-based ACR/EULAR heuristic, treatment, and outcomes."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "remarks": [
        "Seed patients using incidence (1%)"
      ],
      "distributed_transition": [
        {
          "distribution": 0.01,
          "transition": "Delay_Until_Arthritis"
        },
        {
          "distribution": 0.99,
          "transition": "Terminal"
        }
      ]
    },
    "Delay_Until_Arthritis": {
      "type": "Delay",
      "range": {
        "low": 25,
        "high": 80,
        "unit": "years"
      },
      "direct_transition": "RA_Symptom1"
    },
    "RA_Symptom1": {
      "type": "Symptom",
      "symptom": "Joint Pain",
      "range": {
        "low": 0,
        "high": 50
      },
      "direct_transition": "RA_Symptom2"
    },
    "RA_Symptom2": {
      "type": "Symptom",
      "symptom": "Joint Stiffness",
      "range": {
        "low": 0,
        "high": 50
      },
      "direct_transition": "RA_Symptom3"
    },
    "RA_Symptom3": {
      "type": "Symptom",
      "symptom": "Joint Swelling",
      "range": {
        "low": 0,
        "high": 50
      },
      "direct_transition": "RA_Symptom4"
    },
    "RA_Symptom4": {
      "type": "Symptom",
      "symptom": "Fatigue",
      "range": {
        "low": 0,
        "high": 20
      },
      "direct_transition": "RA_Symptom5"
    },
    "RA_Symptom5": {
      "type": "Symptom",
      "symptom": "Fever",
      "range": {
        "low": 0,
        "high": 20
      },
      "direct_transition": "Primary_Care_Visit"
    },
    "Primary_Care_Visit": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for check up (procedure)"
        }
      ],
      "reason": "RA_Symptom5",
      "direct_transition": "Initial_Labs"
    },
    "Initial_Labs": {
      "type": "Procedure",
      "remarks": [
        "Blood draw for the RF/anti-CCP/CRP workup; the individual result codes live on the Observation states below (Lab_Results, AntiCCP_Test, CRP_Result), not here -- a Procedure state needs a procedure code, not three LOINC result codes."
      ],
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "28520004",
          "display": "Venipuncture for blood test (procedure)"
        }
      ],
      "direct_transition": "Lab_Results"
    },
    "Lab_Results": {
      "type": "Observation",
      "category": "laboratory",
      "unit": "[IU]/mL",
      "distributed_transition": [
        {
          "distribution": 0.6,
          "transition": "RF_Positive"
        },
        {
          "distribution": 0.4,
          "transition": "RF_Negative"
        }
      ],
      "range": {
        "low": 5,
        "high": 150
      },
      "codes": [
        {
          "system": "LOINC",
          "code": "11572-5",
          "display": "Rheumatoid factor [Units/volume] in Serum"
        }
      ]
    },
    "RF_Positive": {
      "type": "SetAttribute",
      "attribute": "rf_positive",
      "value": true,
      "direct_transition": "AntiCCP_Test"
    },
    "RF_Negative": {
      "type": "SetAttribute",
      "attribute": "rf_positive",
      "value": false,
      "direct_transition": "AntiCCP_Test"
    },
    "AntiCCP_Test": {
      "type": "Observation",
      "category": "laboratory",
      "unit": "[arb'U]/mL",
      "distributed_transition": [
        {
          "distribution": 0.55,
          "transition": "AntiCCP_Pos"
        },
        {
          "distribution": 0.45,
          "transition": "AntiCCP_Neg"
        }
      ],
      "range": {
        "low": 5,
        "high": 250
      },
      "codes": [
        {
          "system": "LOINC",
          "code": "32167-9",
          "display": "Cyclic citrullinated peptide Ab [Units/volume] in Serum"
        }
      ]
    },
    "AntiCCP_Pos": {
      "type": "SetAttribute",
      "attribute": "anti_ccp_positive",
      "value": true,
      "direct_transition": "CRP_Result"
    },
    "AntiCCP_Neg": {
      "type": "SetAttribute",
      "attribute": "anti_ccp_positive",
      "value": false,
      "direct_transition": "CRP_Result"
    },
    "CRP_Result": {
      "type": "Observation",
      "category": "laboratory",
      "unit": "mg/L",
      "distributed_transition": [
        {
          "distribution": 0.5,
          "transition": "CRP_High"
        },
        {
          "distribution": 0.5,
          "transition": "CRP_Normal"
        }
      ],
      "range": {
        "low": 1,
        "high": 60
      },
      "codes": [
        {
          "system": "LOINC",
          "code": "1988-5",
          "display": "C reactive protein [Mass/volume] in Serum or Plasma"
        }
      ]
    },
    "CRP_High": {
      "type": "SetAttribute",
      "attribute": "crp_high",
      "value": true,
      "direct_transition": "Small_Joint_Count_Draw"
    },
    "CRP_Normal": {
      "type": "SetAttribute",
      "attribute": "crp_high",
      "value": false,
      "direct_transition": "Small_Joint_Count_Draw"
    },
    "Small_Joint_Count_Draw": {
      "type": "SetAttribute",
      "attribute": "small_joint_count",
      "remarks": [
        "assign_to_attribute on an Observation state is silently dropped by the engine -- draw the value here via SetAttribute, then emit it below via Observation.attribute."
      ],
      "distribution": {
        "kind": "UNIFORM",
        "round": true,
        "parameters": {
          "low": 0,
          "high": 28
        }
      },
      "direct_transition": "Joint_Count_Assessment"
    },
    "Joint_Count_Assessment": {
      "type": "Observation",
      "category": "exam",
      "unit": "{count}",
      "attribute": "small_joint_count",
      "codes": [
        {
          "system": "LOINC",
          "code": "88981-6",
          "display": "Tender joint"
        }
      ],
      "direct_transition": "Encounter_Ends_After_Workup"
    },
    "Encounter_Ends_After_Workup": {
      "type": "EncounterEnd",
      "remarks": [
        "Close Primary_Care_Visit here so it never sits open across the 3-6mo Watchful_Waiting delay below (CRITICAL encounter-lock fix)."
      ],
      "direct_transition": "ACR_EULAR_Heuristic"
    },
    "ACR_EULAR_Heuristic": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "anti_ccp_positive",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "rf_positive",
                "operator": "==",
                "value": true
              }
            ]
          },
          "transition": "Rheumatoid_Arthritis_Onset"
        },
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "small_joint_count",
                "operator": ">=",
                "value": 4
              },
              {
                "condition_type": "Attribute",
                "attribute": "crp_high",
                "operator": "==",
                "value": true
              }
            ]
          },
          "transition": "Rheumatoid_Arthritis_Onset"
        },
        {
          "transition": "Watchful_Waiting"
        }
      ]
    },
    "Watchful_Waiting": {
      "type": "Delay",
      "range": {
        "low": 3,
        "high": 6,
        "unit": "months"
      },
      "direct_transition": "Rheumatoid_Arthritis_Onset"
    },
    "Rheumatoid_Arthritis_Onset": {
      "type": "ConditionOnset",
      "target_encounter": "Rheumatology_Referral",
      "assign_to_attribute": "rheumatoid_arthritis",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "69896004",
          "display": "Rheumatoid arthritis"
        }
      ],
      "direct_transition": "Rheumatology_Referral"
    },
    "Rheumatology_Referral": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185347001",
          "display": "Encounter for problem (procedure)"
        }
      ],
      "direct_transition": "RA_CarePlan"
    },
    "RA_CarePlan": {
      "type": "CarePlanStart",
      "assign_to_attribute": "ra_careplan",
      "reason": "Rheumatoid_Arthritis_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "408869004",
          "display": "Musculoskeletal care (regime/therapy)"
        }
      ],
      "activities": [
        {
          "system": "SNOMED-CT",
          "code": "183301007",
          "display": "Physical exercises (regime/therapy)"
        },
        {
          "system": "SNOMED-CT",
          "code": "229580007",
          "display": "Ice therapy (procedure)"
        },
        {
          "system": "SNOMED-CT",
          "code": "11816003",
          "display": "Diet education (procedure)"
        }
      ],
      "direct_transition": "RA_Nonopioid_Pain_Medication"
    },
    "RA_Nonopioid_Pain_Medication": {
      "type": "MedicationOrder",
      "reason": "Rheumatoid_Arthritis_Onset",
      "chronic": true,
      "remarks": [
        "Chronic: NSAID pain control typically continues alongside DMARD therapy for the life of the disease, not a single unrenewed fill.",
        "The former gate here was a Date >= 1990 conditional_transition: in a modern-clock simulated population essentially every patient is diagnosed long after 1990, so the else-branch (Corticosteroid-only) was structurally dead. Rewired to a distributed_transition modeling the real-world minority who are DMARD-intolerant/contraindicated (pregnancy, active infection, significant hepatic/renal disease, frailty) and are managed on corticosteroid monotherapy instead."
      ],
      "codes": [
        {
          "system": "RxNorm",
          "code": "198014",
          "display": "Naproxen 500 MG Oral Tablet"
        }
      ],
      "distributed_transition": [
        {
          "distribution": 0.88,
          "transition": "DMARD"
        },
        {
          "distribution": 0.12,
          "transition": "Corticosteroid"
        }
      ]
    },
    "DMARD": {
      "type": "MedicationOrder",
      "reason": "Rheumatoid_Arthritis_Onset",
      "chronic": true,
      "remarks": [
        "Chronic: methotrexate is continued indefinitely as maintenance DMARD therapy for RA, not stopped on a fixed timetable. DMARD_Treatment_Period below models years of ongoing chronic therapy before a remission-taper assessment; only the minority who reach sustained drug-free remission (~15%, consistent with EULAR guidance on tapering DMARDs after sustained remission) get an explicit MedicationEnd -- the rest continue on chronic methotrexate for the rest of Living_With_RA via annual auto-renewal."
      ],
      "codes": [
        {
          "system": "RxNorm",
          "code": "105585",
          "display": "Methotrexate 2.5 MG Oral Tablet"
        }
      ],
      "direct_transition": "Biologic_Escalation_Check"
    },
    "Biologic_Escalation_Check": {
      "type": "Simple",
      "remarks": [
        "Roughly 30% of RA patients escalate from conventional synthetic DMARD",
        "monotherapy to a biologic within a few years of diagnosis (Curtis,",
        "Arthritis Care Res 2018 reports 25-35% biologic use in commercially",
        "insured RA cohorts). Guarded by an attribute so escalation happens",
        "once, not at every visit."
      ],
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "ra_biologic_started",
            "operator": "is not nil"
          },
          "transition": "Biologic_Escalation_Done"
        },
        { "transition": "Biologic_Escalation_Uptake" }
      ]
    },
    "Biologic_Escalation_Uptake": {
      "type": "Simple",
      "distributed_transition": [
        { "distribution": 0.30, "transition": "Biologic_Agent_Selection" },
        { "distribution": 0.70, "transition": "Biologic_Escalation_Done" }
      ]
    },
    "Biologic_Agent_Selection": {
      "type": "Simple",
      "remarks": [
        "TNF inhibitors are first-line biologics and hold the majority of RA",
        "biologic volume, with adalimumab and etanercept the two largest;",
        "abatacept, tocilizumab and rituximab follow after TNF failure.",
        "All are injected or infused, hence administration: true."
      ],
      "distributed_transition": [
        { "distribution": 0.32, "transition": "Biologic_Adalimumab" },
        { "distribution": 0.26, "transition": "Biologic_Etanercept" },
        { "distribution": 0.16, "transition": "Biologic_Infliximab" },
        { "distribution": 0.12, "transition": "Biologic_Abatacept" },
        { "distribution": 0.09, "transition": "Biologic_Tocilizumab" },
        { "distribution": 0.05, "transition": "Biologic_Rituximab" }
      ]
    },
    "Biologic_Adalimumab": {
      "type": "MedicationOrder",
      "administration": true,
      "codes": [
        { "system": "RxNorm", "code": "1551887", "display": "adalimumab injection" }
      ],
      "direct_transition": "Mark_Biologic_Started"
    },
    "Biologic_Etanercept": {
      "type": "MedicationOrder",
      "administration": true,
      "codes": [
        { "system": "RxNorm", "code": "1653225", "display": "etanercept injection" }
      ],
      "direct_transition": "Mark_Biologic_Started"
    },
    "Biologic_Infliximab": {
      "type": "MedicationOrder",
      "administration": true,
      "codes": [
        { "system": "RxNorm", "code": "213361", "display": "infliximab injection" }
      ],
      "direct_transition": "Mark_Biologic_Started"
    },
    "Biologic_Abatacept": {
      "type": "MedicationOrder",
      "administration": true,
      "codes": [
        { "system": "RxNorm", "code": "1145929", "display": "abatacept injection" }
      ],
      "direct_transition": "Mark_Biologic_Started"
    },
    "Biologic_Tocilizumab": {
      "type": "MedicationOrder",
      "administration": true,
      "codes": [
        { "system": "RxNorm", "code": "1441527", "display": "tocilizumab injection" }
      ],
      "direct_transition": "Mark_Biologic_Started"
    },
    "Biologic_Rituximab": {
      "type": "MedicationOrder",
      "administration": true,
      "codes": [
        { "system": "RxNorm", "code": "121191", "display": "rituximab injection" }
      ],
      "direct_transition": "Mark_Biologic_Started"
    },
    "Mark_Biologic_Started": {
      "type": "SetAttribute",
      "attribute": "ra_biologic_started",
      "value": true,
      "direct_transition": "Biologic_Escalation_Done"
    },
    "Biologic_Escalation_Done": {
      "type": "Simple",
      "direct_transition": "Encounter_Ends_After_DMARD"
    },
    "Encounter_Ends_After_DMARD": {
      "type": "EncounterEnd",
      "direct_transition": "DMARD_Treatment_Period"
    },
    "DMARD_Treatment_Period": {
      "type": "Delay",
      "range": {
        "low": 40,
        "high": 60,
        "unit": "months"
      },
      "distributed_transition": [
        {
          "distribution": 0.15,
          "transition": "End_DMARD"
        },
        {
          "distribution": 0.85,
          "transition": "Living_With_RA"
        }
      ]
    },
    "End_DMARD": {
      "type": "MedicationEnd",
      "medication_order": "DMARD",
      "direct_transition": "RA_Ends"
    },
    "Corticosteroid": {
      "type": "MedicationOrder",
      "reason": "Rheumatoid_Arthritis_Onset",
      "codes": [
        {
          "system": "RxNorm",
          "code": "312615",
          "display": "predniSONE 20 MG Oral Tablet"
        }
      ],
      "direct_transition": "Encounter_Ends_After_Corticosteroids"
    },
    "Encounter_Ends_After_Corticosteroids": {
      "type": "EncounterEnd",
      "direct_transition": "Corticosteroid_Treatment"
    },
    "Corticosteroid_Treatment": {
      "type": "Delay",
      "range": {
        "low": 2,
        "high": 4,
        "unit": "weeks"
      },
      "direct_transition": "End_Corticosteroid"
    },
    "End_Corticosteroid": {
      "type": "MedicationEnd",
      "medication_order": "Corticosteroid",
      "distributed_transition": [
        {
          "distribution": 0.2,
          "transition": "RA_Ends"
        },
        {
          "distribution": 0.8,
          "transition": "Living_With_RA"
        }
      ]
    },
    "Living_With_RA": {
      "type": "Delay",
      "range": {
        "low": 3,
        "high": 15,
        "unit": "years"
      },
      "distributed_transition": [
        {
          "distribution": 0.125,
          "transition": "Setup_Knee_Replacement"
        },
        {
          "distribution": 0.125,
          "transition": "Setup_Hip_Replacement"
        },
        {
          "distribution": 0.75,
          "transition": "Terminal"
        }
      ]
    },
    "Setup_Knee_Replacement": {
      "type": "SetAttribute",
      "attribute": "joint_replacement",
      "value": "knee",
      "direct_transition": "Terminal"
    },
    "Setup_Hip_Replacement": {
      "type": "SetAttribute",
      "attribute": "joint_replacement",
      "value": "hip",
      "direct_transition": "Terminal"
    },
    "RA_Ends": {
      "type": "ConditionEnd",
      "condition_onset": "Rheumatoid_Arthritis_Onset",
      "direct_transition": "End_RA_CarePlan"
    },
    "End_RA_CarePlan": {
      "type": "CarePlanEnd",
      "careplan": "RA_CarePlan",
      "direct_transition": "End_RA_Nonopioid"
    },
    "End_RA_Nonopioid": {
      "type": "MedicationEnd",
      "medication_order": "RA_Nonopioid_Pain_Medication",
      "direct_transition": "RA_Symptom1_Ends"
    },
    "RA_Symptom1_Ends": {
      "type": "Symptom",
      "symptom": "Joint Pain",
      "exact": {
        "quantity": 0
      },
      "direct_transition": "RA_Symptom2_Ends"
    },
    "RA_Symptom2_Ends": {
      "type": "Symptom",
      "symptom": "Joint Stiffness",
      "exact": {
        "quantity": 0
      },
      "direct_transition": "RA_Symptom3_Ends"
    },
    "RA_Symptom3_Ends": {
      "type": "Symptom",
      "symptom": "Joint Swelling",
      "exact": {
        "quantity": 0
      },
      "direct_transition": "RA_Symptom4_Ends"
    },
    "RA_Symptom4_Ends": {
      "type": "Symptom",
      "symptom": "Fatigue",
      "exact": {
        "quantity": 0
      },
      "direct_transition": "RA_Symptom5_Ends"
    },
    "RA_Symptom5_Ends": {
      "type": "Symptom",
      "symptom": "Fever",
      "exact": {
        "quantity": 0
      },
      "direct_transition": "Terminal"
    },
    "Terminal": {
      "type": "Terminal"
    }
  }
}
