    },
    "EndFallAdmission": {
      "type": "EncounterEnd",
      "direct_transition": "PalliativeCareReferral"
    },
    "StartDonepezil": {
      "type": "MedicationOrder",
      "codes": [
        {
          "system": "RxNorm",
          "code": "997223",
          "display": "donepezil hydrochloride 10 MG Oral Tablet"
        }
