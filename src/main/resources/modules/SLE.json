      "range": {
        "low": 3,
        "high": 6,
        "unit": "months"
      },
      "direct_transition": "Flare_Check"
    },
    "Flare_Check": {
      "type": "Simple",
      "name": "Flare_Check",
      "distributed_transition": [
        {
          "distribution": 0.4,
          "transition": "SLE_Flare"
        },
        {
          "distribution": 0.6,
          "transition": "Flare_Check_Encounter_End"
        }
      ]
    },
    "SLE_Flare": {
