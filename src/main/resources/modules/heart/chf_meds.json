{
  "name": "chf_meds",
  "specialty": "CARDIOVASCULAR DISEASE (CARDIOLOGY)",
  "remarks": [
    "Congestive Heart Failure Medications."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "CHF_Medication_Encounter"
    },
    "Terminal": {
      "type": "Terminal"
    },
    "Initialize Check": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Initialize",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_med_check",
            "operator": "is nil"
          }
        },
        {
          "transition": "Advance"
        }
      ]
    },
    "BNP_Monitoring": {
      "type": "Observation",
      "category": "laboratory",
      "codes": [
        {
          "system": "LOINC",
          "code": "33762-6",
          "display": "NT-proBNP"
        }
      ],
      "direct_transition": "CHF_Medication_Encounter_End"
    },
    "Initialize": {
      "type": "SetAttribute",
      "attribute": "chf_med_step",
      "direct_transition": "Branch",
      "value": 1
    },
    "Branch": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Terminal",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_med_step",
            "operator": ">",
            "value": 3
          }
        },
        {
          "transition": "HFmEF",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_type",
            "operator": "==",
            "value": "HFmEF"
          }
        },
        {
          "transition": "HFpEF",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_type",
            "operator": "==",
            "value": "HFpEF"
          }
        },
        {
          "transition": "HFrEF Branch",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_type",
            "operator": "==",
            "value": "HFrEF"
          }
        },
        {
          "transition": "Terminal"
        }
      ]
    },
    "Advance": {
      "type": "Counter",
      "attribute": "chf_med_step",
      "action": "increment",
      "direct_transition": "Branch"
    },
    "HFmEF": {
      "type": "CallSubmodule",
      "submodule": "heart/chf_meds_hfmef",
      "direct_transition": "Terminal"
    },
    "HFpEF": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Empagliflozin",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_med_step",
            "operator": "==",
            "value": 1
          }
        },
        {
          "transition": "CHF_Medication_Encounter_End"
        }
      ]
    },
    "BB_Supply_Delay": {
      "type": "Delay",
      "range": {
        "low": 30,
        "high": 30,
        "unit": "days"
      },
      "direct_transition": "BB_End"
    },
    "BB_End": {
      "type": "MedicationEnd",
      "referenced_by_attribute": "carvedilol_25_mg_oral_tablet_rx",
      "direct_transition": "ACE_ARB_ARNI_Choice"
    },
    "Diuretic": {
      "type": "MedicationOrder",
      "codes": [
        {
          "system": "RxNorm",
          "code": "313988",
          "display": "Furosemide 40 MG Oral Tablet"
        }
      ],
      "reason": "chf",
      "prescription": {
        "dosage": {
          "amount": 1,
          "frequency": 2,
          "period": 1,
          "unit": "days"
        },
        "duration": {
          "quantity": 30,
          "unit": "days"
        },
        "as_needed": true
      },
      "chronic": true,
      "direct_transition": "Diuretic_Supply_Delay",
      "assign_to_attribute": "furosemide_40_mg_oral_tablet_rx"
    },
    "HFrEF Branch": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "HFrEF NYHA 1",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "nyha_class",
            "operator": "==",
            "value": 1
          }
        },
        {
          "transition": "HFrEF NYHA 2",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "nyha_class",
            "operator": "==",
            "value": 2
          }
        },
        {
          "transition": "HFrEF NYHA 3",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "nyha_class",
            "operator": "==",
            "value": 3
          }
        },
        {
          "transition": "HFrEF NYHA 4",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "nyha_class",
            "operator": "==",
            "value": 4
          }
        },
        {
          "transition": "HFrEF NYHA 4"
        }
      ]
    },
    "Empagliflozin": {
