      "codes": [
        {
          "system": "RxNorm",
          "code": "197931",
          "display": "Mercaptopurine 50 MG Oral Tablet"
        }
      ],
      "chronic": true,
      "prescription": {
        "dosage": {
          "amount": 1,
          "frequency": 1,
          "period": 1,
          "unit": "days"
        },
        "duration": {
          "quantity": 730,
          "unit": "days"
        }
      },
      "direct_transition": "Maintenance_Mercaptopurine_Supply_Delay"
    },
    "Rapid_Disease_Progression": {
      "type": "Delay",
      "range": {
        "low": 2,
        "high": 8,
        "unit": "weeks"
      },
      "remarks": [
        "ALL progresses rapidly without treatment",
        "Typically fatal within weeks to months if untreated"
      ],
      "distributed_transition": [
        {
          "transition": "CNS_Involvement_Check",
          "distribution": 0.85
        },
        {
          "transition": "Emergency_Complications",
          "distribution": 0.15
        }
      ]
    },
    "CNS_Involvement_Check": {
      "type": "Simple",
      "distributed_transition": [
        {
          "transition": "Treatment_Phase_Assessment",
          "distribution": 0.9
        },
        {
          "transition": "CNS_Leukemia",
          "distribution": 0.1
        }
      ],
      "remarks": [
        "CNS involvement occurs in ~10% of ALL cases at diagnosis",
        "More common in T-cell ALL and high-risk cases",
        "NOTE: 90% proceed to treatment WITHOUT CNS involvement, 10% develop CNS leukemia"
      ]
    },
    "CNS_Leukemia": {
      "type": "ConditionOnset",
      "remarks": [
        "CORRECTED: 277534002 fails the SNOMED CT Verhoeff check digit. 61301000119102 verified active via SNOMED CT $lookup and already carries a condition_code_map row (C91.00, CNS involvement)."
      ],
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "61301000119102",
          "display": "Disorder of central nervous system co-occurrent and due to acute lymphoid leukemia (disorder)"
        }
      ],
      "direct_transition": "CNS_Symptoms"
    },
    "CNS_Symptoms": {
