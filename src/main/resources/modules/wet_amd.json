          "transition": "High_Risk_Smoking",
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "smoker",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "former_smoker",
                "operator": "==",
                "value": true
              }
            ]
          }
        },
        {
          "transition": "Check_Family_History"
        }
      ]
    },
    "High_Risk_Smoking": {
