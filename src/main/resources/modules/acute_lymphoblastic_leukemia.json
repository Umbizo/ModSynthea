      },
      "direct_transition": "Severe_ALL_Symptom_3"
    },
    "Severe_ALL_Symptom_3": {
      "type": "Symptom",
      "symptom": "Severe Bleeding",
      "range": {
        "low": 50,
        "high": 90
      },
      "direct_transition": "Severe_ALL_Symptom_4"
    },
    "Severe_ALL_Symptom_4": {
      "type": "Symptom",
      "symptom": "Severe Bone Pain",
      "range": {
        "low": 60,
        "high": 100
      },
      "direct_transition": "Severe_ALL_Symptom_5"
    },
    "Severe_ALL_Symptom_5": {
