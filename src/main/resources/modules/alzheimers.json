    "MCI_Age_Guard": {
      "type": "Guard",
      "remarks": [
        "Task 1.6 containment fix: the pre-fix module opened MildCognitiveImpairment",
        "unconditionally off a fixed birth-anchored delay chain, so ~100% of the",
        "population eventually got MCI. Gate entry at 65 (population-level MCI risk",
        "is concentrated in older adults; Synthea's other cognitive-decline module,",
        "dementia.json, uses a similar late-life entry window) and let",
        "Annual_MCI_Incidence_Check do the actual (low) per-year rolling."
      ],
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 65,
        "unit": "years"
      },
      "direct_transition": "Annual_MCI_Incidence_Check"
    },
    "Annual_MCI_Incidence_Check": {
      "type": "Delay",
      "remarks": [
        "Task 1.6 containment fix: annual reroll loop, not a birth/age roll.",
        "1.5%/yr approximates population-based amnestic-MCI incidence in adults",
        "65+ (pooled cohort estimates cluster around 1-2%/100 person-years, e.g.",
        "the Mayo Clinic Study of Aging; Petersen RC, 'Mild Cognitive Impairment',",
        "Continuum (Minneap Minn) 2016;22(2):404-418). Calibration approximation",
        "per the fix brief, not a literature-exact replication."
      ],
      "range": {
        "low": 350,
        "high": 380,
        "unit": "days"
      },
      "distributed_transition": [
        {
          "distribution": 0.015,
          "transition": "MildCognitiveImpairment"
        },
        {
          "distribution": 0.985,
          "transition": "Annual_MCI_Incidence_Check"
        }
      ]
    },
