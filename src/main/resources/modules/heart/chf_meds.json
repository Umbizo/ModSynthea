{
  "name": "chf_meds",
  "specialty": "CARDIOVASCULAR DISEASE (CARDIOLOGY)",
  "remarks": [
    "Congestive Heart Failure Medications.",
    "",
    "Task 1.7 remediation (2026-08-10): 'chf_med_check' was a typo for",
    "'chf_med_step' -- nothing ever wrote 'chf_med_check', so 'Initialize Check'",
    "always re-initialized chf_med_step to 1, freezing titration at step 1 for",
    "life (MRA/ivabradine/BiDil/digoxin/ARNI-switch dead code). Fixed to read",
    "'chf_med_step', the attribute every other state in this module writes.",
    "",
    "All medication orders for a visit now fire back-to-back (same clinical",
    "visit, zero elapsed time) and CHF_Medication_Encounter closes",
    "(EncounterEnd) immediately afterward; every *_Supply_Delay that used to",
    "run BEFORE the close (holding the ambulatory encounter reservation open",
    "for cumulative months) now runs AFTER it. The 30-day MedicationEnd on",
    "each chronic:true GDMT drug is deleted -- the engine's own chronic-",
    "medication renewal (State.java ~963) refills these annually, so an",
    "explicit 30-day end just produced 1 fill/drug/yr instead of ~12.",
    "Every path that used to reach this module's own Terminal state directly",
    "(step>3 fully-titrated, HFmEF submodule return, HFrEF NYHA1 no-op",
    "revisit) now closes the encounter first -- Terminal does NOT auto-close",
    "an open encounter for modules loaded from a subdirectory (State.java",
    "Terminal.process: 'only auto-close encounter for top-level modules',",
    "gated on `!module.submodule`; every file under modules/heart/ is",
    "structurally a submodule regardless of how it's invoked)."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "CHF_Medication_Encounter"
    },
    "Terminal": {
      "type": "Terminal"
    },
    "Initialize Check": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Initialize",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_med_step",
            "operator": "is nil"
          }
        },
        {
          "transition": "Advance"
        }
      ]
    },
    "BNP_Monitoring": {
      "type": "Observation",
      "category": "laboratory",
      "codes": [
        {
          "system": "LOINC",
          "code": "33762-6",
          "display": "NT-proBNP"
        }
      ],
      "direct_transition": "CHF_Medication_Encounter_End"
    },
    "Initialize": {
      "type": "SetAttribute",
      "attribute": "chf_med_step",
      "direct_transition": "Branch",
      "value": 1
    },
    "Branch": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "No_Titration_Encounter_End",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_med_step",
            "operator": ">",
            "value": 3
          }
        },
        {
          "transition": "HFmEF",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_type",
            "operator": "==",
            "value": "HFmEF"
          }
        },
        {
          "transition": "HFpEF",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_type",
            "operator": "==",
            "value": "HFpEF"
          }
        },
        {
          "transition": "HFrEF Branch",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_type",
            "operator": "==",
            "value": "HFrEF"
          }
        },
        {
          "transition": "No_Titration_Encounter_End"
        }
      ]
    },
    "Advance": {
      "type": "Counter",
      "attribute": "chf_med_step",
      "action": "increment",
      "direct_transition": "Branch"
    },
    "HFmEF": {
      "type": "CallSubmodule",
      "submodule": "heart/chf_meds_hfmef",
      "direct_transition": "No_Titration_Encounter_End"
    },
    "HFpEF": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Empagliflozin",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_med_step",
            "operator": "==",
            "value": 1
          }
        },
        {
          "transition": "No_Titration_Encounter_End"
        }
      ]
    },
    "Diuretic": {
      "type": "MedicationOrder",
      "codes": [
        {
          "system": "RxNorm",
          "code": "313988",
          "display": "Furosemide 40 MG Oral Tablet"
        }
      ],
      "reason": "chf",
      "prescription": {
        "dosage": {
          "amount": 1,
          "frequency": 2,
          "period": 1,
          "unit": "days"
        },
        "duration": {
          "quantity": 30,
          "unit": "days"
        },
        "as_needed": true
      },
      "chronic": true,
      "direct_transition": "BNP_Monitoring",
      "assign_to_attribute": "furosemide_40_mg_oral_tablet_rx"
    },
    "HFrEF Branch": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "HFrEF NYHA 1",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "nyha_class",
            "operator": "==",
            "value": 1
          }
        },
        {
          "transition": "HFrEF NYHA 2",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "nyha_class",
            "operator": "==",
            "value": 2
          }
        },
        {
          "transition": "HFrEF NYHA 3",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "nyha_class",
            "operator": "==",
            "value": 3
          }
        },
        {
          "transition": "HFrEF NYHA 4",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "nyha_class",
            "operator": "==",
            "value": 4
          }
        },
        {
          "transition": "HFrEF NYHA 4"
        }
      ]
    },
    "Empagliflozin": {
      "type": "MedicationOrder",
      "codes": [
        {
          "system": "RxNorm",
          "code": "1545658",
          "display": "empagliflozin 10 MG Oral Tablet"
        }
      ],
      "reason": "chf",
      "prescription": {
        "dosage": {
          "amount": 1,
          "frequency": 1,
          "period": 1,
          "unit": "days"
        },
        "duration": {
          "quantity": 30,
          "unit": "days"
        },
        "as_needed": true
      },
      "chronic": true,
      "direct_transition": "Diuretic",
      "assign_to_attribute": "empagliflozin_10_mg_oral_tablet_rx"
    },
    "HFrEF NYHA 1": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "BB",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "chf_med_step",
            "operator": "==",
            "value": 1
          }
        },
        {
          "transition": "No_Titration_Encounter_End"
        }
      ]
    },
    "HFrEF NYHA 2": {
      "type": "CallSubmodule",
      "submodule": "heart/chf_meds_hfref_nyha2",
      "direct_transition": "Terminal"
    },
    "HFrEF NYHA 3": {
      "type": "CallSubmodule",
      "submodule": "heart/chf_meds_hfref_nyha3",
      "direct_transition": "Terminal"
    },
    "HFrEF NYHA 4": {
      "type": "CallSubmodule",
      "submodule": "heart/chf_meds_hfref_nyha4",
      "direct_transition": "Terminal"
    },
    "BB": {
      "type": "MedicationOrder",
      "codes": [
        {
          "system": "RxNorm",
          "code": 200033,
          "display": "carvedilol 25 MG Oral Tablet"
        }
      ],
      "reason": "chf",
      "prescription": {
        "dosage": {
          "amount": 1,
          "frequency": 2,
          "period": 1,
          "unit": "days"
        },
        "duration": {
          "quantity": 30,
          "unit": "days"
        },
        "as_needed": true
      },
      "chronic": true,
      "direct_transition": "ACE_ARB_ARNI_Choice",
      "assign_to_attribute": "carvedilol_25_mg_oral_tablet_rx"
    },
    "CHF_Medication_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185345009",
          "display": "Encounter for medication review"
        }
      ],
      "direct_transition": "Initialize Check"
    },
    "CHF_Medication_Encounter_End": {
      "type": "EncounterEnd",
      "remarks": [
        "The 'did work this visit' closer -- reached only after every GDMT",
        "order for this titration step has been placed. Chains into the",
        "post-close *_Supply_Delay sequence (moved here from before the",
        "close per Task 1.7) before returning to Terminal."
      ],
      "direct_transition": "BB_Supply_Delay"
    },
    "No_Titration_Encounter_End": {
      "type": "EncounterEnd",
      "remarks": [
        "Closer for visits where nothing new was ordered this pass (already",
        "fully titrated past step 3, HFmEF/HFpEF maintenance revisits, or an",
        "HFrEF NYHA1 revisit past step 1) -- no post-close delay needed."
      ],
      "direct_transition": "Terminal"
    },
    "ACE_ARB_ARNI_Choice": {
      "type": "Simple",
      "distributed_transition": [
        {
          "transition": "ACE",
          "distribution": 0.4
        },
        {
          "transition": "ARB",
          "distribution": 0.4
        },
        {
          "transition": "ARNI",
          "distribution": 0.2
        }
      ]
    },
