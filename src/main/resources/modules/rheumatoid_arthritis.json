{
  "name": "Rheumatoid_Arthritis",
  "gmf_version": 2,
  "remarks": [
    "RA module integrating incidence, symptom onset, lab-based ACR/EULAR heuristic, treatment, and outcomes."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "remarks": [
        "Seed patients using incidence (1%)"
      ],
      "distributed_transition": [
        {
          "distribution": 0.01,
          "transition": "Delay_Until_Arthritis"
        },
        {
          "distribution": 0.99,
          "transition": "Terminal"
        }
      ]
    },
    "Delay_Until_Arthritis": {
      "type": "Delay",
      "range": {
        "low": 25,
        "high": 80,
        "unit": "years"
      },
      "direct_transition": "RA_Symptom1"
    },
    "RA_Symptom1": {
      "type": "Symptom",
      "symptom": "Joint Pain",
      "range": {
        "low": 0,
        "high": 50
      },
      "direct_transition": "RA_Symptom2"
    },
    "RA_Symptom2": {
      "type": "Symptom",
      "symptom": "Joint Stiffness",
      "range": {
        "low": 0,
        "high": 50
      },
      "direct_transition": "RA_Symptom3"
    },
    "RA_Symptom3": {
      "type": "Symptom",
      "symptom": "Joint Swelling",
      "range": {
        "low": 0,
        "high": 50
      },
      "direct_transition": "RA_Symptom4"
    },
    "RA_Symptom4": {
      "type": "Symptom",
      "symptom": "Fatigue",
      "range": {
        "low": 0,
        "high": 20
      },
      "direct_transition": "RA_Symptom5"
    },
    "RA_Symptom5": {
      "type": "Symptom",
      "symptom": "Fever",
      "range": {
        "low": 0,
        "high": 20
      },
      "direct_transition": "Primary_Care_Visit"
    },
    "Primary_Care_Visit": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "RA_Symptom5",
      "direct_transition": "Initial_Labs"
    },
    "Initial_Labs": {
      "type": "Procedure",
      "codes": [
        {
          "system": "LOINC",
          "code": "2571-8",
          "display": "Rheumatoid factor"
        },
        {
          "system": "LOINC",
          "code": "33935-8",
          "display": "Cyclic citrullinated peptide IgG Ab [Units/volume] in Serum or Plasma"
        },
        {
          "system": "LOINC",
          "code": "1988-5",
          "display": "C-reactive protein"
        }
      ],
      "direct_transition": "Lab_Results"
    },
    "Lab_Results": {
      "type": "Observation",
      "category": "laboratory",
      "unit": "[IU]/mL",
      "distributed_transition": [
        {
          "distribution": 0.6,
          "transition": "RF_Positive"
        },
        {
          "distribution": 0.4,
          "transition": "RF_Negative"
        }
      ],
      "range": {
        "low": 5,
        "high": 150
      },
      "codes": [
        {
          "system": "LOINC",
          "code": "11572-5",
          "display": "Rheumatoid factor [Units/volume] in Serum"
        }
      ]
    },
    "RF_Positive": {
      "type": "SetAttribute",
      "attribute": "rf_positive",
      "value": true,
      "direct_transition": "AntiCCP_Test"
    },
    "RF_Negative": {
      "type": "SetAttribute",
      "attribute": "rf_positive",
      "value": false,
      "direct_transition": "AntiCCP_Test"
    },
    "AntiCCP_Test": {
      "type": "Observation",
      "category": "laboratory",
      "unit": "[arb'U]/mL",
      "distributed_transition": [
        {
          "distribution": 0.55,
          "transition": "AntiCCP_Pos"
        },
        {
          "distribution": 0.45,
          "transition": "AntiCCP_Neg"
        }
      ],
      "range": {
        "low": 5,
        "high": 250
      },
      "codes": [
        {
          "system": "LOINC",
          "code": "32167-9",
          "display": "Cyclic citrullinated peptide Ab [Units/volume] in Serum"
        }
      ]
    },
    "AntiCCP_Pos": {
      "type": "SetAttribute",
      "attribute": "anti_ccp_positive",
      "value": true,
      "direct_transition": "CRP_Result"
    },
    "AntiCCP_Neg": {
      "type": "SetAttribute",
      "attribute": "anti_ccp_positive",
      "value": false,
      "direct_transition": "CRP_Result"
    },
    "CRP_Result": {
      "type": "Observation",
      "category": "laboratory",
      "unit": "mg/L",
      "distributed_transition": [
        {
          "distribution": 0.5,
          "transition": "CRP_High"
        },
        {
          "distribution": 0.5,
          "transition": "CRP_Normal"
        }
      ],
      "range": {
        "low": 1,
        "high": 60
      },
      "codes": [
        {
          "system": "LOINC",
          "code": "1988-5",
          "display": "C reactive protein [Mass/volume] in Serum or Plasma"
        }
      ]
    },
    "CRP_High": {
      "type": "SetAttribute",
      "attribute": "crp_high",
      "value": true,
      "direct_transition": "Joint_Count_Assessment"
    },
    "CRP_Normal": {
      "type": "SetAttribute",
      "attribute": "crp_high",
      "value": false,
      "direct_transition": "Joint_Count_Assessment"
    },
    "Joint_Count_Assessment": {
      "type": "Observation",
      "category": "exam",
      "unit": "{count}",
      "assign_to_attribute": "small_joint_count",
      "range": {
        "low": 0,
        "high": 28
      },
      "direct_transition": "ACR_EULAR_Heuristic"
    },
    "ACR_EULAR_Heuristic": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "anti_ccp_positive",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "rf_positive",
                "operator": "==",
                "value": true
              }
            ]
          },
          "transition": "Rheumatology_Referral"
        },
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "small_joint_count",
                "operator": ">=",
                "value": 4
              },
              {
                "condition_type": "Attribute",
                "attribute": "crp_high",
                "operator": "==",
                "value": true
              }
            ]
          },
          "transition": "Rheumatology_Referral"
        },
        {
          "transition": "Watchful_Waiting"
        }
      ]
    },
    "Watchful_Waiting": {
      "type": "Delay",
      "range": {
        "low": 3,
        "high": 6,
        "unit": "months"
      },
      "direct_transition": "Rheumatology_Referral"
    },
    "Rheumatology_Referral": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "direct_transition": "RA_CarePlan"
    },
    "RA_CarePlan": {
      "type": "CarePlanStart",
      "assign_to_attribute": "ra_careplan",
      "reason": "Rheumatoid_Arthritis_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "408869004",
          "display": "Musculoskeletal care (regime/therapy)"
        }
      ],
      "activities": [
        {
          "system": "SNOMED-CT",
          "code": "183301007",
          "display": "Physical exercises (regime/therapy)"
        },
        {
          "system": "SNOMED-CT",
          "code": "229580007",
          "display": "Ice therapy (procedure)"
        },
        {
          "system": "SNOMED-CT",
          "code": "11816003",
          "display": "Diet education (procedure)"
        }
      ],
      "direct_transition": "RA_Nonopioid_Pain_Medication"
    },
    "RA_Nonopioid_Pain_Medication": {
      "type": "MedicationOrder",
      "reason": "Rheumatoid_Arthritis_Onset",
      "codes": [
        {
          "system": "RxNorm",
          "code": "198014",
          "display": "Naproxen 500 MG Oral Tablet"
        }
      ],
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Date",
            "operator": ">=",
            "year": 1990
          },
          "transition": "DMARD"
        },
        {
          "transition": "Corticosteroid"
        }
      ]
    },
    "DMARD": {
      "type": "MedicationOrder",
      "reason": "Rheumatoid_Arthritis_Onset",
      "codes": [
        {
          "system": "RxNorm",
          "code": "105585",
          "display": "Methotrexate 2.5 MG Oral Tablet"
        }
      ],
      "direct_transition": "Encounter_Ends_After_DMARD"
    },
    "Encounter_Ends_After_DMARD": {
      "type": "EncounterEnd",
      "direct_transition": "DMARD_Treatment_Period"
    },
    "DMARD_Treatment_Period": {
      "type": "Delay",
      "range": {
        "low": 40,
        "high": 60,
        "unit": "months"
      },
      "direct_transition": "End_DMARD"
    },
    "End_DMARD": {
      "type": "MedicationEnd",
      "medication_order": "DMARD",
      "distributed_transition": [
        {
          "distribution": 0.75,
          "transition": "RA_Ends"
        },
        {
          "distribution": 0.25,
          "transition": "Living_With_RA"
        }
      ]
    },
    "Corticosteroid": {
      "type": "MedicationOrder",
      "reason": "Rheumatoid_Arthritis_Onset",
      "codes": [
        {
          "system": "RxNorm",
          "code": "312615",
          "display": "predniSONE 20 MG Oral Tablet"
        }
      ],
      "direct_transition": "Encounter_Ends_After_Corticosteroids"
    },
    "Encounter_Ends_After_Corticosteroids": {
      "type": "EncounterEnd",
      "direct_transition": "Corticosteroid_Treatment"
    },
    "Corticosteroid_Treatment": {
      "type": "Delay",
      "range": {
        "low": 2,
        "high": 4,
        "unit": "weeks"
      },
      "direct_transition": "End_Corticosteroid"
    },
    "End_Corticosteroid": {
      "type": "MedicationEnd",
      "medication_order": "Corticosteroid",
      "distributed_transition": [
        {
          "distribution": 0.2,
          "transition": "RA_Ends"
        },
        {
          "distribution": 0.8,
          "transition": "Living_With_RA"
        }
      ]
    },
    "Living_With_RA": {
      "type": "Delay",
      "range": {
        "low": 3,
        "high": 15,
        "unit": "years"
      },
      "distributed_transition": [
        {
          "distribution": 0.125,
          "transition": "Setup_Knee_Replacement"
        },
        {
          "distribution": 0.125,
          "transition": "Setup_Hip_Replacement"
        },
        {
          "distribution": 0.75,
          "transition": "Terminal"
        }
      ]
    },
    "Setup_Knee_Replacement": {
      "type": "SetAttribute",
      "attribute": "joint_replacement",
      "value": "knee",
      "direct_transition": "Terminal"
    },
    "Setup_Hip_Replacement": {
      "type": "SetAttribute",
      "attribute": "joint_replacement",
      "value": "hip",
      "direct_transition": "Terminal"
    },
    "RA_Ends": {
      "type": "ConditionEnd",
      "condition_onset": "Rheumatoid_Arthritis_Onset",
      "direct_transition": "End_RA_CarePlan"
    },
    "End_RA_CarePlan": {
      "type": "CarePlanEnd",
      "careplan": "RA_CarePlan",
      "direct_transition": "End_RA_Nonopioid"
    },
    "End_RA_Nonopioid": {
      "type": "MedicationEnd",
      "medication_order": "RA_Nonopioid_Pain_Medication",
      "direct_transition": "RA_Symptom1_Ends"
    },
    "RA_Symptom1_Ends": {
      "type": "Symptom",
      "symptom": "Joint Pain",
      "exact": {
        "quantity": 0
      },
      "direct_transition": "RA_Symptom2_Ends"
    },
    "RA_Symptom2_Ends": {
      "type": "Symptom",
      "symptom": "Joint Stiffness",
      "exact": {
        "quantity": 0
      },
      "direct_transition": "RA_Symptom3_Ends"
    },
    "RA_Symptom3_Ends": {
      "type": "Symptom",
      "symptom": "Joint Swelling",
      "exact": {
        "quantity": 0
      },
      "direct_transition": "RA_Symptom4_Ends"
    },
    "RA_Symptom4_Ends": {
      "type": "Symptom",
      "symptom": "Fatigue",
      "exact": {
        "quantity": 0
      },
      "direct_transition": "RA_Symptom5_Ends"
    },
    "RA_Symptom5_Ends": {
      "type": "Symptom",
      "symptom": "Fever",
      "exact": {
        "quantity": 0
      },
      "direct_transition": "Terminal"
    },
    "Terminal": {
      "type": "Terminal"
    }
  }
}
