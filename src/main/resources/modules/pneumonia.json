{
  "name": "Pneumonia_Enhanced",
  "gmf_version": 2,
  "remarks": [
    "This module supports pediatric, adult, and geriatric populations",
    "Includes mild, moderate, and severe pneumonia with appropriate treatment pathways",
    "This module has expansions of antibiotic pathways and ventilator support",
    "",
    "2026-08-10 remediation (audit Task 1.5): the pre-fix module gave 100% of",
    "patients pneumonia exactly once, at birth, and held encounters open across",
    "30-72 day medication-supply delays and a 5-14 day recovery delay (6 lint",
    "CRITICALs). Replaced the birth roll with an annual age-banded incidence",
    "loop (Annual_Incidence_Check) that allows repeat episodes over a lifetime.",
    "Every encounter in every arm now reaches its EncounterEnd immediately",
    "after orders/observations are recorded; supply/recovery/length-of-stay",
    "delays all sit strictly after the EncounterEnd that opened them, per the",
    "close-before-delay pattern established in Tasks 1.1-1.4. All in-module",
    "codes are SNOMED-CT (or LOINC/RxNorm where appropriate); the ICD-10-CM",
    "and CPT codes that used to be mixed into conditions/procedures/encounters",
    "now live only in the export code maps.",
    "",
    "Overlap guard: the annual reroll loop (Annual_Incidence_Check) is only",
    "ever re-entered after the prior episode's ConditionEnd, because every",
    "severity arm is a single sequential path back to that state -- a person",
    "cannot be mid-episode and back at the reroll check simultaneously. No",
    "separate stacking-guard state is needed; this is a structural invariant",
    "of the graph, not a runtime check."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Annual_Incidence_Check"
    },
    "Annual_Incidence_Check": {
      "type": "Delay",
      "remarks": [
        "Age-banded annual incidence of community-acquired pneumonia (all",
        "severities, not just hospitalized cases): 1.5%/yr under 5, 0.4%/yr",
        "ages 5-64, 2%/yr at 65+. Order-of-magnitude source: Jain et al.,",
        "'Community-Acquired Pneumonia Requiring Hospitalization among U.S.",
        "Children', NEJM 2015;372:835-45, and Jain et al., 'Community-",
        "Acquired Pneumonia Requiring Hospitalization among U.S. Adults',",
        "NEJM 2015;373:415-27 (the CAP-EPIC studies) -- those papers measure",
        "hospitalized CAP only (~1-2/1000/yr in adults), so the rates here",
        "are scaled up to approximate all-severity community incidence,",
        "consistent with the wider epidemiology literature on CAP.",
        "",
        "This state is both the annual timer and the router: the Delay",
        "(370-395 days, always > 1 year) must elapse before the",
        "complex_transition rolls, so the earliest possible onset for any",
        "patient is just past their first birthday -- the pre-fix module's",
        "everyone-at-birth defect cannot recur.",
        "",
        "Bands are evaluated oldest-first because ComplexTransition takes",
        "the first condition that is true. On a no-onset roll, and after",
        "every recovered episode, the loop re-enters this same state,",
        "allowing repeat episodes over a lifetime."
      ],
      "range": {
        "low": 370,
        "high": 395,
        "unit": "days"
      },
      "complex_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 65,
            "unit": "years"
          },
          "distributions": [
            {
              "distribution": 0.02,
              "transition": "PneumoniaOnset"
            },
            {
              "distribution": 0.98,
              "transition": "Annual_Incidence_Check"
            }
          ]
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 5,
            "unit": "years"
          },
          "distributions": [
            {
              "distribution": 0.004,
              "transition": "PneumoniaOnset"
            },
            {
              "distribution": 0.996,
              "transition": "Annual_Incidence_Check"
            }
          ]
        },
        {
          "distributions": [
            {
              "distribution": 0.015,
              "transition": "PneumoniaOnset"
            },
            {
              "distribution": 0.985,
              "transition": "Annual_Incidence_Check"
            }
          ]
        }
      ]
    },
    "PneumoniaOnset": {
      "type": "ConditionOnset",
      "assign_to_attribute": "pneumonia",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "233604007",
          "display": "Pneumonia (disorder)"
        }
      ],
      "direct_transition": "CoughSymptom"
    },
    "CoughSymptom": {
      "type": "Symptom",
      "symptom": "Cough (finding)",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "49727002",
          "display": "Cough (finding)"
        }
      ],
      "exact": {
        "quantity": 1
      },
      "direct_transition": "FeverSymptom"
    },
    "FeverSymptom": {
      "type": "Symptom",
      "symptom": "Fever (finding)",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "386661006",
          "display": "Fever (finding)"
        }
      ],
      "exact": {
        "quantity": 1
      },
      "probability": 0.8,
      "direct_transition": "DyspneaSymptom"
    },
    "DyspneaSymptom": {
      "type": "Symptom",
      "symptom": "Dyspnea (finding)",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "267036007",
          "display": "Dyspnea (finding)"
        }
      ],
      "exact": {
        "quantity": 1
      },
      "probability": 0.6,
      "direct_transition": "ChestPainSymptom"
    },
    "ChestPainSymptom": {
      "type": "Symptom",
      "symptom": "Chest pain (finding)",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "29857009",
          "display": "Chest pain (finding)"
        }
      ],
      "exact": {
        "quantity": 1
      },
      "probability": 0.4,
      "direct_transition": "ED_Visit"
    },
    "ED_Visit": {
      "type": "Encounter",
      "encounter_class": "emergency",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "50849002",
          "display": "Emergency room admission (procedure)"
        }
      ],
      "reason": "pneumonia",
      "direct_transition": "ED_Chest_Xray"
    },
    "ED_Chest_Xray": {
      "type": "Procedure",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "399208008",
          "display": "Plain X-ray of chest (procedure)"
        }
      ],
      "direct_transition": "ED_Visit_End"
    },
    "ED_Visit_End": {
      "type": "EncounterEnd",
      "direct_transition": "DetermineSeverity"
    },
    "DetermineSeverity": {
      "type": "Simple",
      "complex_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 65,
            "unit": "years"
          },
          "distributions": [
            {
              "distribution": 0.5,
              "transition": "MildPneumonia"
            },
            {
              "distribution": 0.3,
              "transition": "ModeratePneumonia"
            },
            {
              "distribution": 0.2,
              "transition": "SeverePneumonia"
            }
          ]
        },
        {
          "distributions": [
            {
              "distribution": 0.3,
              "transition": "MildPneumonia"
            },
            {
              "distribution": 0.4,
              "transition": "ModeratePneumonia"
            },
            {
              "distribution": 0.3,
              "transition": "SeverePneumonia"
            }
          ]
        }
      ]
    },
    "MildPneumonia": {
      "type": "SetAttribute",
      "attribute": "pneumonia_severity",
      "value": "mild",
      "direct_transition": "OutpatientManagement"
    },
    "ModeratePneumonia": {
      "type": "SetAttribute",
      "attribute": "pneumonia_severity",
      "value": "moderate",
      "direct_transition": "InpatientAdmission"
    },
    "SeverePneumonia": {
      "type": "SetAttribute",
      "attribute": "pneumonia_severity",
      "value": "severe",
      "direct_transition": "ICUAdmission"
    },
    "OutpatientManagement": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185347001",
          "display": "Encounter for problem (procedure)"
        }
      ],
      "reason": "pneumonia",
      "direct_transition": "AntibioticTreatmentOutpatient"
    },
    "AntibioticTreatmentOutpatient": {
      "type": "MedicationOrder",
      "codes": [
        {
          "system": "RxNorm",
          "code": "308191",
          "display": "amoxicillin 500 MG Oral Capsule"
        }
      ],
      "reason": "pneumonia",
      "direct_transition": "Doxycycline_Order",
      "assign_to_attribute": "amoxicillin_500_mg_oral_capsule_rx"
    },
    "Doxycycline_Order": {
      "type": "MedicationOrder",
      "assign_to_attribute": "doxycycline_rx",
      "codes": [
        {
          "system": "RxNorm",
          "code": "1649988",
          "display": "doxycycline hyclate 100 MG Oral Capsule"
        }
      ],
      "reason": "pneumonia",
      "direct_transition": "OutpatientManagement_End"
    },
    "OutpatientManagement_End": {
      "type": "EncounterEnd",
      "remarks": [
        "Orders are placed and the encounter closes here; the medication",
        "supply and recovery delays below all run after this EncounterEnd,",
        "per the close-before-delay pattern (was CRITICAL: this encounter",
        "used to stay open across both drugs' delays)."
      ],
      "direct_transition": "AntibioticTreatmentOutpatient_Supply_Delay"
    },
    "AntibioticTreatmentOutpatient_Supply_Delay": {
      "type": "Delay",
      "range": {
        "low": 30,
        "high": 30,
        "unit": "days"
      },
      "direct_transition": "AntibioticTreatmentOutpatient_End"
    },
    "AntibioticTreatmentOutpatient_End": {
      "type": "MedicationEnd",
      "referenced_by_attribute": "amoxicillin_500_mg_oral_capsule_rx",
      "direct_transition": "Doxycycline_End_Delay"
    },
    "Doxycycline_End_Delay": {
      "type": "Delay",
      "range": {
        "low": 7,
        "high": 14,
        "unit": "days"
      },
      "direct_transition": "Doxycycline_End"
    },
    "Doxycycline_End": {
      "type": "MedicationEnd",
      "referenced_by_attribute": "doxycycline_rx",
      "direct_transition": "FollowUpCare"
    },
    "FollowUpCare": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for check up (procedure)"
        }
      ],
      "reason": "pneumonia",
      "direct_transition": "FollowUpCare_End"
    },
    "FollowUpCare_End": {
      "type": "EncounterEnd",
      "remarks": [
        "Closes immediately; RecoveryMild below now runs after this",
        "EncounterEnd (was CRITICAL: this encounter used to stay open",
        "across the 5-14 day recovery delay)."
      ],
      "direct_transition": "RecoveryMild"
    },
    "RecoveryMild": {
      "type": "Delay",
      "range": {
        "low": 5,
        "high": 14,
        "unit": "days"
      },
      "direct_transition": "ConditionEnd_Mild"
    },
    "ConditionEnd_Mild": {
      "type": "ConditionEnd",
      "referenced_by_attribute": "pneumonia",
      "direct_transition": "Annual_Incidence_Check"
    },
    "InpatientAdmission": {
      "type": "Encounter",
      "encounter_class": "inpatient",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "32485007",
          "display": "Hospital admission (procedure)"
        }
      ],
      "reason": "pneumonia",
      "direct_transition": "ChestImagingInpatient"
    },
    "ChestImagingInpatient": {
      "type": "ImagingStudy",
      "procedure_code": {
        "system": "SNOMED-CT",
        "code": "399208008",
        "display": "Plain X-ray of chest (procedure)"
      },
      "series": [
        {
          "body_site": {
            "system": "SNOMED-CT",
            "code": "51185008",
            "display": "Thoracic structure (body structure)"
          },
          "modality": {
            "system": "DICOM-DCM",
            "code": "CR",
            "display": "Computed Radiography"
          },
          "instances": [
            {
              "title": "Chest X-ray",
              "sop_class": {
                "system": "DICOM-SOP",
                "code": "1.2.840.10008.5.1.4.1.1.1.1",
                "display": "Digital X-Ray Image Storage – for Presentation"
              }
            }
          ]
        }
      ],
      "direct_transition": "Ceftriaxone_Order"
    },
    "Ceftriaxone_Order": {
      "type": "MedicationOrder",
      "remarks": [
        "Clinician-administered inpatient IV antibiotic: administration:true",
        "routes this to a professional/inpatient claim line through",
        "rxnorm_hcpcs_map (J0696) rather than modelled as a 30-day retail",
        "supply, and administration rows don't stack, so no MedicationEnd",
        "is needed. Was the *_Supply_Delay idiom (CRITICAL) before this fix."
      ],
      "codes": [
        {
          "system": "RxNorm",
          "code": "1665021",
          "display": "ceftriaxone 1000 MG Injection"
        }
      ],
      "administration": true,
      "reason": "pneumonia",
      "direct_transition": "Azithromycin_Order"
    },
    "Azithromycin_Order": {
      "type": "MedicationOrder",
      "assign_to_attribute": "azithromycin_rx",
      "codes": [
        {
          "system": "RxNorm",
          "code": "248656",
          "display": "azithromycin 500 MG Oral Tablet"
        }
      ],
      "reason": "pneumonia",
      "direct_transition": "CBC_Inpatient"
    },
    "CBC_Inpatient": {
      "type": "Observation",
      "category": "laboratory",
      "codes": [
        {
          "system": "LOINC",
          "code": "6690-2",
          "display": "Leukocytes [#/volume] in Blood"
        }
      ],
      "range": {
        "low": 12000,
        "high": 20000
      },
      "unit": "/uL",
      "direct_transition": "CRP_Inpatient"
    },
    "CRP_Inpatient": {
      "type": "Observation",
      "category": "laboratory",
      "codes": [
        {
          "system": "LOINC",
          "code": "1988-5",
          "display": "C reactive protein"
        }
      ],
      "range": {
        "low": 50,
        "high": 200
      },
      "unit": "mg/L",
      "direct_transition": "Blood_Culture"
    },
    "Blood_Culture": {
      "type": "Observation",
      "category": "laboratory",
      "remarks": [
        "Observation has no 'value' field in the engine (State.java) -- a",
        "bare string here is silently dropped, same defect class as the raw",
        "value blocks below. value_code is the correct idiom for a",
        "qualitative culture result."
      ],
      "codes": [
        {
          "system": "LOINC",
          "code": "600-7",
          "display": "Bacteria identified in Blood by Culture"
        }
      ],
      "value_code": {
        "system": "SNOMED-CT",
        "code": "9861002",
        "display": "Streptococcus pneumoniae (organism)"
      },
      "direct_transition": "OxygenSaturationInpatient"
    },
    "OxygenSaturationInpatient": {
      "type": "Observation",
      "category": "vital-signs",
      "remarks": [
        "Fixed bad-gmf: 'value' is not a field on Observation (State.java),",
        "so the old {type:Range,...} block was silently dropped and every",
        "row recorded NULL. Numeric observations use the top-level 'range'",
        "field instead."
      ],
      "codes": [
        {
          "system": "LOINC",
          "code": "2708-6",
          "display": "Oxygen saturation in Arterial blood"
        }
      ],
      "range": {
        "low": 88,
        "high": 94
      },
      "unit": "%",
      "direct_transition": "InpatientAdmission_Stay"
    },
    "InpatientAdmission_Stay": {
      "type": "Delay",
      "remarks": [
        "Bounded length of stay for a moderate-severity admission, inside",
        "the encounter (legitimate LOS, not a medication-supply delay)."
      ],
      "range": {
        "low": 3,
        "high": 6,
        "unit": "days"
      },
      "direct_transition": "Azithromycin_End"
    },
    "Azithromycin_End": {
      "type": "MedicationEnd",
      "referenced_by_attribute": "azithromycin_rx",
      "direct_transition": "InpatientAdmission_End"
    },
    "InpatientAdmission_End": {
      "type": "EncounterEnd",
      "direct_transition": "RecoveryModerate"
    },
    "RecoveryModerate": {
      "type": "Delay",
      "range": {
        "low": 10,
        "high": 21,
        "unit": "days"
      },
      "direct_transition": "ConditionEnd_Moderate"
    },
    "ConditionEnd_Moderate": {
      "type": "ConditionEnd",
      "referenced_by_attribute": "pneumonia",
      "direct_transition": "Annual_Incidence_Check"
    },
    "ICUAdmission": {
      "type": "Encounter",
      "encounter_class": "inpatient",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "305351004",
          "display": "Admission to intensive care unit (procedure)"
        }
      ],
      "reason": "pneumonia",
      "direct_transition": "IVAntibiotics"
    },
    "IVAntibiotics": {
      "type": "MedicationOrder",
      "remarks": [
        "Clinician-administered ICU IV antibiotic: administration:true",
        "routes this through rxnorm_hcpcs_map (J2543) instead of a 30-day",
        "retail supply; no MedicationEnd needed. Was the *_Supply_Delay",
        "idiom (CRITICAL) before this fix."
      ],
      "codes": [
        {
          "system": "RxNorm",
          "code": "1659137",
          "display": "piperacillin 3000 MG / tazobactam 375 MG Injection"
        }
      ],
      "administration": true,
      "reason": "pneumonia",
      "direct_transition": "CT_Chest"
    },
    "CT_Chest": {
      "type": "Procedure",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "169069000",
          "display": "Computed tomography of thorax (procedure)"
        }
      ],
      "direct_transition": "ABG"
    },
    "ABG": {
      "type": "Observation",
      "category": "laboratory",
      "remarks": [
        "Fixed bad-gmf: see OxygenSaturationInpatient remark."
      ],
      "codes": [
        {
          "system": "LOINC",
          "code": "2744-1",
          "display": "pO2 Arterial"
        }
      ],
      "range": {
        "low": 50,
        "high": 70
      },
      "unit": "mmHg",
      "direct_transition": "VentilatorSupport"
    },
    "VentilatorSupport": {
      "type": "Procedure",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "40617009",
          "display": "Artificial respiration (procedure)"
        }
      ],
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<=",
            "quantity": 18,
            "unit": "years"
          },
          "transition": "PediatricComplications"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": ">",
            "quantity": 65,
            "unit": "years"
          },
          "transition": "GeriatricComplications"
        },
        {
          "transition": "ICUAdmission_Stay"
        }
      ]
    },
    "PediatricComplications": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "34020007",
          "display": "Pneumonia caused by Streptococcus (disorder)"
        }
      ],
      "direct_transition": "ICUAdmission_Stay"
    },
    "GeriatricComplications": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "46970008",
          "display": "Pneumonia caused by Mycoplasma pneumoniae (disorder)"
        }
      ],
      "direct_transition": "ICUAdmission_Stay"
    },
    "ICUAdmission_Stay": {
      "type": "Delay",
      "remarks": [
        "Bounded length of stay for a severe/ICU admission, inside the",
        "encounter (legitimate LOS, not a medication-supply delay)."
      ],
      "range": {
        "low": 4,
        "high": 10,
        "unit": "days"
      },
      "direct_transition": "ICUAdmission_End"
    },
    "ICUAdmission_End": {
      "type": "EncounterEnd",
      "direct_transition": "RecoverySevere"
    },
    "RecoverySevere": {
      "type": "Delay",
      "range": {
        "low": 21,
        "high": 42,
        "unit": "days"
      },
      "direct_transition": "ConditionEnd_Severe"
    },
    "ConditionEnd_Severe": {
      "type": "ConditionEnd",
      "referenced_by_attribute": "pneumonia",
      "direct_transition": "Annual_Incidence_Check"
    }
  }
}
