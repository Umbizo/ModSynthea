{
  "name": "Alzheimers Disease Module",
  "remarks": [
    "Comprehensive Alzheimer's disease simulation from preclinical to end-stage",
    "Includes cognitive decline, functional impairment, and behavioral symptoms",
    "Models diagnosis, treatment, caregiver burden, and advanced care planning",
    "Task 1.6 (2026-08-10): containment hotfix -- gated MCI/AD incidence",
    "(age>=65 guard + 1.5%/yr MCI, 10%/yr MCI->AD, both annual reroll loops,",
    "not birth rolls), added post-diagnosis mortality (annual hazard from the",
    "end-stage arm; see EndStage_Mortality_Check), closed the",
    "nursing-home/hospice end-stage loop's encounters explicitly instead of",
    "relying on same-pass supersession, fixed the one lint CRITICAL",
    "(AspirationAdmission had no closer reachable), guarded memantine against",
    "repeat ordering, wrapped the anti-amyloid infusion administration inside",
    "its encounter instead of before it, recoded two CPT procedures to",
    "SNOMED-CT, fixed two dose-form-level RxCUIs to real SCDs, and fixed one",
    "SNOMED code that was reusing HomeHospice's own encounter-type code under",
    "a mismatched display text. Deeper redesign (stage-structured MCI->mild->",
    "moderate->severe progression, dementia.json double-diagnosis",
    "coordination, lecanemab/donanemab gating, CarePlan overhauls) is Task 4.2."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "MCI_Age_Guard"
    },
    "MildCognitiveImpairment": {
      "type": "ConditionOnset",
      "assign_to_attribute": "cognitive_status",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "386805003",
          "display": "Cognitive impairment (finding)"
        },
        {
          "system": "SNOMED-CT",
          "code": "192071009",
          "display": "Mild cognitive impairment, so stated"
        }
      ],
      "direct_transition": "MCI_MoCA"
    },
    "MCI_MoCA": {
      "type": "Observation",
      "category": "exam",
      "codes": [
        {
          "system": "LOINC",
          "code": "72172-0",
          "display": "Montreal Cognitive Assessment total score"
        }
      ],
      "range": {
        "low": 18,
        "high": 25
      },
      "unit": "{score}",
      "remarks": [
        "Task 1.6 containment fix: was a raw `value` block (invalid GMF field on",
        "Observation -> silently dropped by Gson -> recorded NULL for every",
        "patient). MoCA is 0-30; 18-25 approximates the mild-MCI band."
      ],
      "direct_transition": "Memory_Impairment"
    },
    "End_MCI_Encounter": {
      "type": "EncounterEnd",
      "direct_transition": "AmyloidEligibilityAssessment"
    },
    "Memory_Impairment": {
      "type": "Symptom",
      "symptom": "Memory impairment",
      "range": {
        "low": 40,
        "high": 70
      },
      "direct_transition": "PrimaryCareVisit_MCI"
    },
    "PrimaryCareVisit_MCI": {
