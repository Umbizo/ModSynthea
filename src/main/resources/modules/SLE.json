{
  "name": "Systemic Lupus Erythematosus (SLE)",
  "gmf_version": 2,
  "states": {
    "Initial": {
      "type": "Initial",
      "name": "Initial",
      "direct_transition": "Race_Ethnicity_Branch"
    },
    "Race_Ethnicity_Branch": {
      "type": "Simple",
      "name": "Race_Ethnicity_Branch",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "ethnicity",
            "operator": "==",
            "value": "hispanic"
          },
          "transition": "Set_Race_Hispanic"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "race",
            "operator": "==",
            "value": "black"
          },
          "transition": "Set_Race_Black"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "race",
            "operator": "==",
            "value": "asian"
          },
          "transition": "Set_Race_Asian"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "race",
            "operator": "==",
            "value": "native"
          },
          "transition": "Set_Race_Native"
        },
        {
          "condition": {
            "condition_type": "True"
          },
          "transition": "Set_Race_White"
        }
      ]
    },
    "Set_Race_Black": {
      "type": "SetAttribute",
      "name": "Set_Race_Black",
      "attribute": "sle_race_group",
      "value": "black",
      "direct_transition": "Gender_Prevalence_Branch"
    },
    "Set_Race_Hispanic": {
      "type": "SetAttribute",
      "name": "Set_Race_Hispanic",
      "attribute": "sle_race_group",
      "value": "hispanic",
      "direct_transition": "Gender_Prevalence_Branch"
    },
    "Set_Race_Asian": {
      "type": "SetAttribute",
      "name": "Set_Race_Asian",
      "attribute": "sle_race_group",
      "value": "asian",
      "direct_transition": "Gender_Prevalence_Branch"
    },
    "Set_Race_Native": {
      "type": "SetAttribute",
      "name": "Set_Race_Native",
      "attribute": "sle_race_group",
      "value": "native",
      "direct_transition": "Gender_Prevalence_Branch"
    },
    "Set_Race_White": {
      "type": "SetAttribute",
      "name": "Set_Race_White",
      "attribute": "sle_race_group",
      "value": "white",
      "direct_transition": "Gender_Prevalence_Branch"
    },
    "Gender_Prevalence_Branch": {
      "type": "Simple",
      "name": "Gender_Prevalence_Branch",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "gender",
            "operator": "==",
            "value": "F"
          },
          "transition": "Female_SLE_Age_Guard"
        },
        {
          "condition": {
            "condition_type": "True"
          },
          "transition": "Male_SLE_Age_Guard"
        }
      ]
    },
    "Female_SLE_Age_Guard": {
      "type": "Guard",
      "name": "Female_SLE_Age_Guard",
      "remarks": [
        "SLE is overwhelmingly a disease of the reproductive years: incidence rises",
        "sharply after menarche and falls off after menopause. Onset is modelled as",
        "an annual reroll from age 15, not a birth-rolled lifetime draw.",
        "The 15-45 window itself is not from Izmirly et al. (that meta-analysis",
        "reports pooled and race-stratified rates but no age-specific incidence",
        "curve). Fix round 1 (reviewer): cited instead to Rees F, Doherty M,",
        "Grainge MJ, Lanyon P, Zhang W. 'The worldwide incidence and prevalence",
        "of systemic lupus erythematosus: a systematic review of epidemiological",
        "studies.' Rheumatology (Oxford). 2017;56(11):1945-1961, which reports",
        "the female:male ratio rising from 9:1 overall to 13:1 specifically in",
        "the 15-44 age group -- direct evidence that this is where SLE",
        "concentrates. The annual per-race-per-sex rates themselves (below)",
        "remain from Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 15,
        "unit": "years"
      },
      "direct_transition": "Female_Chance_of_SLE"
    },
    "Male_SLE_Age_Guard": {
      "type": "Guard",
      "name": "Male_SLE_Age_Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 15,
        "unit": "years"
      },
      "direct_transition": "Male_Chance_of_SLE"
    },
    "Female_Chance_of_SLE": {
      "type": "Simple",
      "name": "Female_Chance_of_SLE",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "black"
          },
          "transition": "Female_SLE_Chance_Black"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "hispanic"
          },
          "transition": "Female_SLE_Chance_Hispanic"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "asian"
          },
          "transition": "Female_SLE_Chance_Asian"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "native"
          },
          "transition": "Female_SLE_Chance_Native"
        },
        {
          "condition": {
            "condition_type": "True"
          },
          "transition": "Female_SLE_Chance_White"
        }
      ]
    },
    "Male_Chance_of_SLE": {
      "type": "Simple",
      "name": "Male_Chance_of_SLE",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "black"
          },
          "transition": "Male_SLE_Chance_Black"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "hispanic"
          },
          "transition": "Male_SLE_Chance_Hispanic"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "asian"
          },
          "transition": "Male_SLE_Chance_Asian"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "native"
          },
          "transition": "Male_SLE_Chance_Native"
        },
        {
          "condition": {
            "condition_type": "True"
          },
          "transition": "Male_SLE_Chance_White"
        }
      ]
    },
    "Female_SLE_Chance_Black": {
      "type": "Simple",
      "name": "Female_SLE_Chance_Black",
      "remarks": [
        "Annual incidence 15.9/100,000 person-years, Black women.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614 (CDC National Lupus",
        "Registry meta-analysis: Georgia, Michigan, New York, California)."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000159,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999841,
          "transition": "Female_SLE_Annual_Delay"
        }
      ]
    },
    "Female_SLE_Chance_Hispanic": {
      "type": "Simple",
      "name": "Female_SLE_Chance_Hispanic",
      "remarks": [
        "Annual incidence 6.8/100,000 person-years, Hispanic women.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000068,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999932,
          "transition": "Female_SLE_Annual_Delay"
        }
      ]
    },
    "Female_SLE_Chance_Asian": {
      "type": "Simple",
      "name": "Female_SLE_Chance_Asian",
      "remarks": [
        "Annual incidence 7.6/100,000 person-years, Asian/Pacific Islander women.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000076,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999924,
          "transition": "Female_SLE_Annual_Delay"
        }
      ]
    },
    "Female_SLE_Chance_Native": {
      "type": "Simple",
      "name": "Female_SLE_Chance_Native",
      "remarks": [
        "Annual incidence 10.4/100,000 person-years, American Indian/Alaska",
        "Native women -- the second-highest rate of any group in the source.",
        "Caveat (fix round 1, reviewer): this cell rests on the smallest",
        "underlying case counts of any race group in Izmirly et al.'s",
        "meta-analysis (Indian Health Service catchment population) and should",
        "be treated as the least statistically stable of these estimates -- see",
        "Male_SLE_Chance_Black's remarks for the same caveat on the male side.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000104,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999896,
          "transition": "Female_SLE_Annual_Delay"
        }
      ]
    },
    "Female_SLE_Chance_White": {
      "type": "Simple",
      "name": "Female_SLE_Chance_White",
      "remarks": [
        "Annual incidence 5.7/100,000 person-years, White women.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000057,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999943,
          "transition": "Female_SLE_Annual_Delay"
        }
      ]
    },
    "Male_SLE_Chance_Black": {
      "type": "Simple",
      "name": "Male_SLE_Chance_Black",
      "remarks": [
        "FIX ROUND 1 (reviewer correction): round 0 scaled these male rates by",
        "0.795 and justified it as reconciling this source's 'own pooled 8.7:1'",
        "against a commonly cited ~9:1 -- but 8.7 is Izmirly's pooled FEMALE rate",
        "(8.7/100,000 person-years), not a ratio; the source's true pooled ratio",
        "is 8.7/1.2 = 7.25:1 (1.2/100,000 being the pooled male rate). The scaling",
        "was chasing a target the source never actually reported. Removed: these",
        "are now Izmirly et al.'s raw, unscaled race-specific male rates (Black",
        "men 2.4/100,000/yr, etc.), exactly as reported. The population-weighted",
        "(2020 Census race shares, approx. White .60/Hispanic .18/Black .13/",
        "Asian .06/Native .01) female:male ratio these unscaled rates produce is",
        "7.27e-05/1.02e-05 = 7.16:1, closely matching the source's own true",
        "7.25:1 -- consistent rather than forced. The commonly cited ~9:1",
        "(CDC/Lupus Foundation of America) is a real figure from a different",
        "source (see Rees et al. 2017, cited on Female_SLE_Age_Guard, which",
        "independently reports 9:1 overall).",
        "Caveat: the American Indian/Alaska Native cells (both sexes) rest on the",
        "smallest underlying case counts of any race group in Izmirly et al.'s",
        "meta-analysis (Indian Health Service catchment population, a much",
        "smaller registry than the other four sites) and should be treated as",
        "the least statistically stable of these six estimates.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000024,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999976,
          "transition": "Male_SLE_Annual_Delay"
        }
      ]
    },
    "Male_SLE_Chance_Hispanic": {
      "type": "Simple",
      "name": "Male_SLE_Chance_Hispanic",
      "remarks": [
        "0.9/100,000/yr, Hispanic men -- unscaled, see Male_SLE_Chance_Black for",
        "the round-1 correction removing the round-0 x0.795 scale.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000009,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999991,
          "transition": "Male_SLE_Annual_Delay"
        }
      ]
    },
    "Male_SLE_Chance_Asian": {
      "type": "Simple",
      "name": "Male_SLE_Chance_Asian",
      "remarks": [
        "0.4/100,000/yr, Asian/Pacific Islander men -- unscaled, see",
        "Male_SLE_Chance_Black for the round-1 correction removing the round-0",
        "x0.795 scale. Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000004,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999996,
          "transition": "Male_SLE_Annual_Delay"
        }
      ]
    },
    "Male_SLE_Chance_Native": {
      "type": "Simple",
      "name": "Male_SLE_Chance_Native",
      "remarks": [
        "3.8/100,000/yr, American Indian/Alaska Native men -- the highest male",
        "rate of any group in the source; unscaled, see Male_SLE_Chance_Black for",
        "the round-1 correction removing the round-0 x0.795 scale, and for the",
        "AI/AN small-sample caveat. Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000038,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999962,
          "transition": "Male_SLE_Annual_Delay"
        }
      ]
    },
    "Male_SLE_Chance_White": {
      "type": "Simple",
      "name": "Male_SLE_Chance_White",
      "remarks": [
        "0.8/100,000/yr, White men -- unscaled, see Male_SLE_Chance_Black for the",
        "round-1 correction removing the round-0 x0.795 scale.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000008,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999992,
          "transition": "Male_SLE_Annual_Delay"
        }
      ]
    },
    "Female_SLE_Annual_Delay": {
      "type": "Delay",
      "name": "Female_SLE_Annual_Delay",
      "range": {
        "low": 11,
        "high": 13,
        "unit": "months"
      },
      "direct_transition": "Female_SLE_Age_Window_Check"
    },
    "Male_SLE_Annual_Delay": {
      "type": "Delay",
      "name": "Male_SLE_Annual_Delay",
      "range": {
        "low": 11,
        "high": 13,
        "unit": "months"
      },
      "direct_transition": "Male_SLE_Age_Window_Check"
    },
    "Female_SLE_Age_Window_Check": {
      "type": "Simple",
      "name": "Female_SLE_Age_Window_Check",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 45,
            "unit": "years"
          },
          "transition": "Female_Chance_of_SLE"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 45,
            "unit": "years"
          },
          "transition": "Terminal"
        }
      ]
    },
    "Male_SLE_Age_Window_Check": {
      "type": "Simple",
      "name": "Male_SLE_Age_Window_Check",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 45,
            "unit": "years"
          },
          "transition": "Male_Chance_of_SLE"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 45,
            "unit": "years"
          },
          "transition": "Terminal"
        }
      ]
    },
    "Diagnose_SLE": {
      "type": "ConditionOnset",
      "name": "Diagnose_SLE",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "55464009",
          "display": "Systemic lupus erythematosus"
        }
      ],
      "target_encounter": "Diagnosis_Encounter",
      "direct_transition": "Diagnosis_Encounter"
    },
    "Diagnosis_Encounter": {
      "type": "Encounter",
