    "BB_Supply_Delay": {
      "type": "Delay",
      "remarks": [
        "Post-close titration-cadence delay (Task 1.7) -- fires only after",
        "CHF_Medication_Encounter_End, never while the encounter is open.",
        "Routes to whichever of ACE/ARB/ARNI was actually ordered this visit",
        "via GDMT_Choice_Delay_Router; falls back to the ARNI leg for the",
        "HFpEF step-1 path, which never ordered BB/ACE/ARB/ARNI at all -- a",
        "harmless mislabeling of a generic post-visit wait, not a correctness",
        "issue (the encounter is already closed either way)."
      ],
      "range": {
        "low": 30,
        "high": 30,
        "unit": "days"
      },
      "direct_transition": "GDMT_Choice_Delay_Router"
    },
    "GDMT_Choice_Delay_Router": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "ACE_Supply_Delay",
          "condition": {
            "condition_type": "PriorState",
            "name": "ACE"
          }
        },
        {
          "transition": "ARB_Supply_Delay",
          "condition": {
