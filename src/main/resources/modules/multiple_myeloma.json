  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "MGUS_Age_Gate"
    },
    "MGUS_Age_Gate": {
      "type": "Guard",
      "remarks": [
        "Task 2.9 (audit 2026-08-10): MGUS risk was previously rolled once",
        "at birth (3% of newborns), which is clinically wrong -- MGUS is",
        "vanishingly rare before mid-life and its prevalence rises sharply",
        "with age. Gate the one-shot 3% check to age 50, matching Kyle RA,",
        "Rajkumar SV. 'Monoclonal gammopathy of undetermined significance.'",
        "Br J Haematol. 2006;134(6):573-589 (prevalence ~3.2% at age 50+)."
      ],
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 50,
        "unit": "years"
      },
      "direct_transition": "MGUS_Risk"
    },
