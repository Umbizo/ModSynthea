          "system": "SNOMED-CT",
          "code": "185347001",
          "display": "Encounter for problem (procedure)"
        }
      ],
      "direct_transition": "MCI_Cognitive_Assessment"
    },
    "MCI_Cognitive_Assessment": {
      "type": "Procedure",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "113024001",
          "display": "Assessment and interpretation of higher cerebral function, cognitive testing"
        }
      ],
      "remarks": [
        "Task 1.6 containment fix: was CPT 99483 (bad-system per the scanner --",
        "this tree only accepts SNOMED-CT/RxNorm/LOINC/CVX/DICOM). 113024001",
        "confirmed active via Ontoserver $lookup and mapped to 99483 in",
        "hcpcs_code_map.json so the CPT billing code is preserved on export."
