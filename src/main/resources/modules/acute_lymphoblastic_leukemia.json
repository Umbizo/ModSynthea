      "encounter_class": "inpatient",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "32485007",
          "display": "Hospital admission"
        }
      ],
      "direct_transition": "Baseline_CBC"
    },
    "Baseline_CBC": {
      "type": "Observation",
      "category": "laboratory",
      "unit": "10*3/uL",
      "codes": [
        {
          "system": "LOINC",
          "code": "6690-2",
          "display": "Leukocytes [#/volume] in Blood"
        }
      ],
      "range": {
        "low": 1,
        "high": 100
      },
      "direct_transition": "Bone_Marrow_Biopsy"
    },
    "Bone_Marrow_Report": {
      "type": "DiagnosticReport",
      "codes": [
        {
          "system": "LOINC",
          "code": "47286-0",
          "display": "Bone marrow differential panel"
        }
      ],
      "observations": [
        {
          "category": "laboratory",
          "codes": [
            {
              "system": "LOINC",
              "code": "26464-8",
              "display": "Leukemic blasts"
            }
          ]
        }
      ],
      "direct_transition": "Induction_Chemotherapy"
    },
    "Induction_Chemotherapy": {
      "type": "MedicationOrder",
      "codes": [
        {
          "system": "RxNorm",
          "code": "1863354",
          "display": "Vincristine Injectable Product"
        }
      ],
      "administration": true,
      "direct_transition": "Prednisone"
    },
    "Prednisone": {
      "type": "MedicationOrder",
      "codes": [
        {
          "system": "RxNorm",
          "code": "8640",
          "display": "Prednisone Oral Tablet"
        }
      ],
      "assign_to_attribute": "all_prednisone",
      "chronic": true,
      "prescription": {
        "dosage": {
          "amount": 2,
          "frequency": 2,
          "period": 1,
          "unit": "days"
        },
        "duration": {
          "quantity": 28,
          "unit": "days"
        }
      },
      "direct_transition": "Induction_LOS"
    },
    "Bone_Marrow_Biopsy": {
      "type": "Procedure",
      "remarks": [
        "Fix round 1 (cross-module, reviewer): recoded from 86273004 (the generic",
        "root 'Biopsy' concept -- its hcpcs_code_map row bills CPT 38221 correctly",
        "for a bone marrow biopsy only by coincidence of a shared map row, not",
        "because 86273004 itself means bone marrow biopsy) to 234326005 'Bone",
        "marrow biopsy (procedure)', matching myelodysplastic_syndromes.json and",
        "acute_myeloid_leukemia.json's Bone_Marrow_Biopsy states. Existing",
        "hcpcs_code_map row (234326005 -> G0364) covers it; no new row needed."
      ],
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "234326005",
          "display": "Bone marrow biopsy"
        }
      ],
      "direct_transition": "Bone_Marrow_Report"
    },
    "ALL_Induction_Discharge": {
      "type": "EncounterEnd",
      "direct_transition": "ALL_Monitoring"
    },
    "ALL_Monitoring": {
