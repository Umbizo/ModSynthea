      "type": "Delay",
      "remarks": [
        "21-day R-CHOP cycle interval. The encounter is already closed (via",
        "Medical_Oncology_Encounter_End above), so this multi-day gap sits",
        "entirely outside any open encounter -- the closed-before-blocked",
        "pattern the encounter-lock linter requires."
      ],
      "range": {
        "low": 20,
        "high": 22,
        "unit": "days"
      },
      "direct_transition": "RCHOP_Cycle_Visit"
    },
