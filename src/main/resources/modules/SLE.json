{
  "name": "Systemic Lupus Erythematosus (SLE)",
  "gmf_version": 2,
  "states": {
    "Initial": {
      "type": "Initial",
      "name": "Initial",
      "direct_transition": "Race_Ethnicity_Branch"
    },
    "Race_Ethnicity_Branch": {
      "type": "Simple",
      "name": "Race_Ethnicity_Branch",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "ethnicity",
            "operator": "==",
            "value": "hispanic"
          },
          "transition": "Set_Race_Hispanic"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "race",
            "operator": "==",
            "value": "black"
          },
          "transition": "Set_Race_Black"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "race",
            "operator": "==",
            "value": "asian"
          },
          "transition": "Set_Race_Asian"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "race",
            "operator": "==",
            "value": "native"
          },
          "transition": "Set_Race_Native"
        },
        {
          "condition": {
            "condition_type": "True"
          },
          "transition": "Set_Race_White"
        }
      ]
    },
    "Set_Race_Black": {
      "type": "SetAttribute",
      "name": "Set_Race_Black",
      "attribute": "sle_race_group",
      "value": "black",
      "direct_transition": "Gender_Prevalence_Branch"
    },
    "Set_Race_Hispanic": {
      "type": "SetAttribute",
      "name": "Set_Race_Hispanic",
      "attribute": "sle_race_group",
      "value": "hispanic",
      "direct_transition": "Gender_Prevalence_Branch"
    },
    "Set_Race_Asian": {
      "type": "SetAttribute",
      "name": "Set_Race_Asian",
      "attribute": "sle_race_group",
      "value": "asian",
      "direct_transition": "Gender_Prevalence_Branch"
    },
    "Set_Race_Native": {
      "type": "SetAttribute",
      "name": "Set_Race_Native",
      "attribute": "sle_race_group",
      "value": "native",
      "direct_transition": "Gender_Prevalence_Branch"
    },
    "Set_Race_White": {
      "type": "SetAttribute",
      "name": "Set_Race_White",
      "attribute": "sle_race_group",
      "value": "white",
      "direct_transition": "Gender_Prevalence_Branch"
    },
    "Gender_Prevalence_Branch": {
      "type": "Simple",
      "name": "Gender_Prevalence_Branch",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "gender",
            "operator": "==",
            "value": "F"
          },
          "transition": "Female_SLE_Age_Guard"
        },
        {
          "condition": {
            "condition_type": "True"
          },
          "transition": "Male_SLE_Age_Guard"
        }
      ]
    },
    "Female_SLE_Age_Guard": {
      "type": "Guard",
      "name": "Female_SLE_Age_Guard",
      "remarks": [
        "SLE is overwhelmingly a disease of the reproductive years: incidence rises",
        "sharply after menarche and falls off after menopause. Onset is modelled as",
        "an annual reroll from age 15, not a birth-rolled lifetime draw.",
        "Source: Izmirly PM, Ferucci ED, Somers EC, et al. Incidence rates of",
        "systemic lupus erythematosus in the USA: estimates from a meta-analysis",
        "of the Centers for Disease Control and Prevention national lupus",
        "registries. Lupus Sci Med. 2021;8(1):e000614."
      ],
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 15,
        "unit": "years"
      },
      "direct_transition": "Female_Chance_of_SLE"
    },
    "Male_SLE_Age_Guard": {
      "type": "Guard",
      "name": "Male_SLE_Age_Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 15,
        "unit": "years"
      },
      "direct_transition": "Male_Chance_of_SLE"
    },
    "Female_Chance_of_SLE": {
      "type": "Simple",
      "name": "Female_Chance_of_SLE",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "black"
          },
          "transition": "Female_SLE_Chance_Black"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "hispanic"
          },
          "transition": "Female_SLE_Chance_Hispanic"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "asian"
          },
          "transition": "Female_SLE_Chance_Asian"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "native"
          },
          "transition": "Female_SLE_Chance_Native"
        },
        {
          "condition": {
            "condition_type": "True"
          },
          "transition": "Female_SLE_Chance_White"
        }
      ]
    },
    "Male_Chance_of_SLE": {
      "type": "Simple",
      "name": "Male_Chance_of_SLE",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "black"
          },
          "transition": "Male_SLE_Chance_Black"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "hispanic"
          },
          "transition": "Male_SLE_Chance_Hispanic"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "asian"
          },
          "transition": "Male_SLE_Chance_Asian"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "sle_race_group",
            "operator": "==",
            "value": "native"
          },
          "transition": "Male_SLE_Chance_Native"
        },
        {
          "condition": {
            "condition_type": "True"
          },
          "transition": "Male_SLE_Chance_White"
        }
      ]
    },
    "Female_SLE_Chance_Black": {
      "type": "Simple",
      "name": "Female_SLE_Chance_Black",
      "remarks": [
        "Annual incidence 15.9/100,000 person-years, Black women.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614 (CDC National Lupus",
        "Registry meta-analysis: Georgia, Michigan, New York, California)."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000159,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999841,
          "transition": "Female_SLE_Annual_Delay"
        }
      ]
    },
    "Female_SLE_Chance_Hispanic": {
      "type": "Simple",
      "name": "Female_SLE_Chance_Hispanic",
      "remarks": [
        "Annual incidence 6.8/100,000 person-years, Hispanic women.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000068,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999932,
          "transition": "Female_SLE_Annual_Delay"
        }
      ]
    },
    "Female_SLE_Chance_Asian": {
      "type": "Simple",
      "name": "Female_SLE_Chance_Asian",
      "remarks": [
        "Annual incidence 7.6/100,000 person-years, Asian/Pacific Islander women.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000076,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999924,
          "transition": "Female_SLE_Annual_Delay"
        }
      ]
    },
    "Female_SLE_Chance_Native": {
      "type": "Simple",
      "name": "Female_SLE_Chance_Native",
      "remarks": [
        "Annual incidence 10.4/100,000 person-years, American Indian/Alaska",
        "Native women -- the second-highest rate of any group in the source.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000104,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999896,
          "transition": "Female_SLE_Annual_Delay"
        }
      ]
    },
    "Female_SLE_Chance_White": {
      "type": "Simple",
      "name": "Female_SLE_Chance_White",
      "remarks": [
        "Annual incidence 5.7/100,000 person-years, White women.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000057,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999943,
          "transition": "Female_SLE_Annual_Delay"
        }
      ]
    },
    "Male_SLE_Chance_Black": {
      "type": "Simple",
      "name": "Male_SLE_Chance_Black",
      "remarks": [
        "Male rates are the same-source race-specific figures (Black men",
        "2.4/100,000/yr) scaled by 0.795 so the population-weighted (2020 Census",
        "race shares, approx. White .60/Hispanic .18/Black .13/Asian .06/",
        "Native .01) female:male ratio lands at the commonly cited ~9:1",
        "(CDC/Lupus Foundation of America) rather than this source's own pooled",
        "8.7:1. Relative ordering across race groups is unchanged by the scale.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000019,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999981,
          "transition": "Male_SLE_Annual_Delay"
        }
      ]
    },
    "Male_SLE_Chance_Hispanic": {
      "type": "Simple",
      "name": "Male_SLE_Chance_Hispanic",
      "remarks": [
        "0.9/100,000/yr, Hispanic men, x0.795 scale -- see Male_SLE_Chance_Black.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000007,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999993,
          "transition": "Male_SLE_Annual_Delay"
        }
      ]
    },
    "Male_SLE_Chance_Asian": {
      "type": "Simple",
      "name": "Male_SLE_Chance_Asian",
      "remarks": [
        "0.4/100,000/yr, Asian/Pacific Islander men, x0.795 scale -- see",
        "Male_SLE_Chance_Black. Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000003,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999997,
          "transition": "Male_SLE_Annual_Delay"
        }
      ]
    },
    "Male_SLE_Chance_Native": {
      "type": "Simple",
      "name": "Male_SLE_Chance_Native",
      "remarks": [
        "3.8/100,000/yr, American Indian/Alaska Native men -- the highest male",
        "rate of any group in the source, x0.795 scale -- see",
        "Male_SLE_Chance_Black. Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.00003,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.99997,
          "transition": "Male_SLE_Annual_Delay"
        }
      ]
    },
    "Male_SLE_Chance_White": {
      "type": "Simple",
      "name": "Male_SLE_Chance_White",
      "remarks": [
        "0.8/100,000/yr, White men, x0.795 scale -- see Male_SLE_Chance_Black.",
        "Izmirly et al., Lupus Sci Med. 2021;8(1):e000614."
      ],
      "distributed_transition": [
        {
          "distribution": 0.000006,
          "transition": "Diagnose_SLE"
        },
        {
          "distribution": 0.999994,
          "transition": "Male_SLE_Annual_Delay"
        }
      ]
    },
    "Female_SLE_Annual_Delay": {
      "type": "Delay",
      "name": "Female_SLE_Annual_Delay",
      "range": {
        "low": 11,
        "high": 13,
        "unit": "months"
      },
      "direct_transition": "Female_SLE_Age_Window_Check"
    },
    "Male_SLE_Annual_Delay": {
      "type": "Delay",
      "name": "Male_SLE_Annual_Delay",
      "range": {
        "low": 11,
        "high": 13,
        "unit": "months"
      },
      "direct_transition": "Male_SLE_Age_Window_Check"
    },
    "Female_SLE_Age_Window_Check": {
      "type": "Simple",
      "name": "Female_SLE_Age_Window_Check",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 45,
            "unit": "years"
          },
          "transition": "Female_Chance_of_SLE"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 45,
            "unit": "years"
          },
          "transition": "Terminal"
        }
      ]
    },
    "Male_SLE_Age_Window_Check": {
      "type": "Simple",
      "name": "Male_SLE_Age_Window_Check",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 45,
            "unit": "years"
          },
          "transition": "Male_Chance_of_SLE"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 45,
            "unit": "years"
          },
          "transition": "Terminal"
        }
      ]
    },
    "Diagnose_SLE": {
      "type": "ConditionOnset",
      "name": "Diagnose_SLE",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "55464009",
          "display": "Systemic lupus erythematosus"
        }
      ],
      "target_encounter": "Diagnosis_Encounter",
      "direct_transition": "Diagnosis_Encounter"
    },
    "Diagnosis_Encounter": {
      "type": "Encounter",
      "name": "Diagnosis_Encounter",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185347001",
          "display": "Encounter for problem (procedure)"
        }
      ],
      "direct_transition": "ANA_Test"
    },
    "ANA_Test": {
      "type": "Observation",
      "name": "ANA_Test",
      "category": "laboratory",
      "unit": "{titer}",
      "codes": [
        {
          "system": "LOINC",
          "code": "29953-7",
          "display": "Nuclear Ab [Titer] in Serum"
        }
      ],
      "range": {
        "low": 80,
        "high": 640
      },
      "addresses": "Diagnose_SLE",
      "direct_transition": "Start_HCQ"
    },
    "Start_HCQ": {
      "type": "MedicationOrder",
      "name": "Start_HCQ",
      "codes": [
        {
          "system": "RxNorm",
          "code": "979092",
          "display": "hydroxychloroquine sulfate 200 MG Oral Tablet"
        }
      ],
      "direct_transition": "Start_HCQ_Encounter_End"
    },
    "Followup_Loop": {
      "type": "Delay",
      "name": "Followup_Loop",
      "range": {
        "low": 3,
        "high": 6,
        "unit": "months"
      },
      "direct_transition": "Flare_Check"
    },
    "Flare_Check": {
      "type": "Simple",
      "name": "Flare_Check",
      "distributed_transition": [
        {
          "distribution": 0.4,
          "transition": "SLE_Flare"
        },
        {
          "distribution": 0.6,
          "transition": "Flare_Check_Encounter_End"
        }
      ]
    },
    "SLE_Flare": {
      "type": "Encounter",
      "name": "SLE_Flare",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185347001",
          "display": "Encounter for problem (procedure)"
        }
      ],
      "direct_transition": "SLE_Flare_Encounter_End"
    },
    "Terminal": {
      "type": "Terminal",
      "name": "Terminal"
    },
    "Start_HCQ_Encounter_End": {
      "type": "EncounterEnd",
      "direct_transition": "Followup_Loop"
    },
    "Flare_Check_Encounter_End": {
      "type": "EncounterEnd",
      "direct_transition": "Followup_Loop"
    },
    "SLE_Flare_Encounter_End": {
      "type": "EncounterEnd",
      "direct_transition": "Followup_Loop"
    }
  }
}
