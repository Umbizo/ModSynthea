{
  "name": "Wet Age-Related Macular Degeneration",
  "remarks": [
    "This module models wet (neovascular) age-related macular degeneration (AMD),",
    "a serious eye condition that causes rapid vision loss in the central field of vision.",
    "Wet AMD accounts for about 10-15% of all AMD cases but causes 90% of severe vision loss.",
    "It typically affects people over 50, with increasing prevalence with age.",
    "The module includes risk factors, progression from dry AMD, diagnostic procedures,",
    "and current treatment modalities including anti-VEGF therapy.",
    "References: AAO Retina/Vitreous Panel. Preferred Practice Pattern Guidelines.",
    "Age-Related Macular Degeneration. San Francisco, CA: American Academy of Ophthalmology; 2019."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Age_Guard"
    },
    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 50,
        "unit": "years"
      },
      "direct_transition": "Risk_Factor_Assessment"
    },
    "Risk_Factor_Assessment": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "High_Risk_Smoking",
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "smoker",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "former_smoker",
                "operator": "==",
                "value": true
              }
            ]
          }
        },
        {
          "transition": "Check_Family_History"
        }
      ]
    },
    "High_Risk_Smoking": {
      "type": "SetAttribute",
      "attribute": "amd_risk_factor_smoking",
      "value": true,
      "direct_transition": "Check_Family_History"
    },
    "Check_Family_History": {
      "type": "Simple",
      "distributed_transition": [
        {
          "transition": "Family_History_Positive",
          "distribution": 0.2
        },
        {
          "transition": "Check_Existing_Dry_AMD",
          "distribution": 0.8
        }
      ]
    },
    "Family_History_Positive": {
      "type": "SetAttribute",
      "attribute": "amd_family_history",
      "value": true,
      "direct_transition": "Check_Existing_Dry_AMD"
    },
    "Check_Existing_Dry_AMD": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Existing_Dry_AMD",
          "condition": {
            "condition_type": "Active Condition",
            "codes": [
              {
                "system": "SNOMED-CT",
                "code": "267718000",
                "display": "Age-related macular degeneration"
              }
            ]
          }
        },
        {
          "transition": "Age_Based_AMD_Risk"
        }
      ]
    },
    "Existing_Dry_AMD": {
      "type": "SetAttribute",
      "attribute": "has_dry_amd",
      "value": true,
      "direct_transition": "Dry_AMD_Monitoring_Period"
    },
    "Age_Based_AMD_Risk": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Very_High_Age_Risk",
          "condition": {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 75,
            "unit": "years"
          }
        },
        {
          "transition": "High_Age_Risk",
          "condition": {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 65,
            "unit": "years"
          }
        },
        {
          "transition": "Standard_Age_Risk"
        }
      ]
    },
    "Very_High_Age_Risk": {
      "type": "Simple",
      "distributed_transition": [
        {
          "transition": "Develop_Dry_AMD_First",
          "distribution": 0.25
        },
        {
          "transition": "No_AMD_Development",
          "distribution": 0.75
        }
      ]
    },
    "High_Age_Risk": {
      "type": "Simple",
      "distributed_transition": [
        {
          "transition": "Develop_Dry_AMD_First",
          "distribution": 0.15
        },
        {
          "transition": "No_AMD_Development",
          "distribution": 0.85
        }
      ]
    },
    "Standard_Age_Risk": {
      "type": "Simple",
      "distributed_transition": [
        {
          "transition": "Develop_Dry_AMD_First",
          "distribution": 0.05
        },
        {
          "transition": "No_AMD_Development",
          "distribution": 0.95
        }
      ]
    },
    "Develop_Dry_AMD_First": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "267718000",
          "display": "Age-related macular degeneration"
        }
      ],
      "direct_transition": "Set_Dry_AMD_Attribute"
    },
    "Set_Dry_AMD_Attribute": {
      "type": "SetAttribute",
      "attribute": "has_dry_amd",
      "value": true,
      "direct_transition": "Dry_AMD_Monitoring_Period"
    },
    "Dry_AMD_Monitoring_Period": {
      "type": "Delay",
      "range": {
        "low": 1,
        "high": 5,
        "unit": "years"
      },
      "direct_transition": "Wet_AMD_Risk_Assessment"
    },
    "Wet_AMD_Risk_Assessment": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "High_Risk_Wet_AMD_Development",
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "amd_risk_factor_smoking",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "amd_family_history",
                "operator": "==",
                "value": true
              }
            ]
          }
        },
        {
          "transition": "Moderate_Risk_Wet_AMD_Development",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "has_dry_amd",
            "operator": "==",
            "value": true
          }
        },
        {
          "transition": "Low_Risk_Wet_AMD_Development"
        }
      ]
    },
    "High_Risk_Wet_AMD_Development": {
      "type": "Simple",
      "distributed_transition": [
        {
          "transition": "Early_Wet_AMD_Symptoms",
          "distribution": 0.2
        },
        {
          "transition": "No_AMD_Development",
          "distribution": 0.8
        }
      ]
    },
    "Moderate_Risk_Wet_AMD_Development": {
      "type": "Simple",
      "distributed_transition": [
        {
