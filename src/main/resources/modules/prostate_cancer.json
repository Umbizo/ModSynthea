            "condition_type": "Attribute",
            "attribute": "prostate_cancer_risk",
            "operator": "==",
            "value": "favorable_intermediate"
          },
          "distributions": [
            {
              "transition": "Active_Surveillance",
              "distribution": 0.4
            },
            {
              "transition": "End_Visit_For_Surgery",
