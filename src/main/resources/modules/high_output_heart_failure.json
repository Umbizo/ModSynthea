{
  "name": "high_output_heart_failure",
  "remarks": [
    "Simulates high-output heart failure in adults with risk factors such as anemia, hyperthyroidism, AV fistula, or pregnancy.",
    "Updated with realistic incidence, symptoms, and diagnostics"
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "CheckRiskFactors"
    },
    "CheckRiskFactors": {
      "type": "Guard",
      "allow": {
        "condition_type": "And",
        "conditions": [
          {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 20,
            "unit": "years"
          },
          {
            "condition_type": "Age",
            "operator": "<=",
            "quantity": 70,
            "unit": "years"
          },
          {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "anemia",
                "operator": "is not nil"
              },
              {
                "condition_type": "Attribute",
                "attribute": "hyperthyroidism",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "av_fistula",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "pregnant",
                "operator": "==",
                "value": true
              }
            ]
          }
        ]
      },
      "direct_transition": "OnsetHighOutputHF"
    },
    "OnsetHighOutputHF": {
      "type": "Simple",
      "direct_transition": "OnsetHighOutputHF_Action_1"
    },
    "HighOutputHF_Maintenance": {
      "type": "Delay",
      "range": {
        "low": 30,
        "high": 90,
        "unit": "days"
      },
      "distributed_transition": [
        {
          "distribution": 0.1,
          "transition": "HighOutputHF_Decompensation"
        },
        {
          "distribution": 0.9,
          "transition": "HighOutputHF_Maintenance_Actions"
        }
      ]
    },
    "HighOutputHF_Maintenance_Actions": {
      "type": "Simple",
      "direct_transition": "HighOutputHF_Maintenance_Actions_Action_1"
    },
    "HighOutputHF_Decompensation": {
      "type": "Simple",
      "direct_transition": "HighOutputHF_Decompensation_Action_1"
    },
    "Terminal": {
      "type": "Terminal"
    },
    "OnsetHighOutputHF_Action_1": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for cardiovascular examination"
        }
      ],
      "direct_transition": "OnsetHighOutputHF_Action_2"
    },
    "OnsetHighOutputHF_Action_2": {
      "type": "ConditionOnset",
      "assign_to_attribute": "high_output_hf",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "10091002",
          "display": "High output heart failure"
        },
        {
          "system": "ICD-10-CM",
          "code": "I50.9",
          "display": "Heart failure, unspecified"
        },
        {
          "system": "ICD-10-CM",
          "code": "I50.89",
          "display": "Other heart failure"
        }
      ],
      "direct_transition": "OnsetHighOutputHF_Action_3"
    },
    "OnsetHighOutputHF_Action_3": {
      "type": "Symptom",
      "symptom": "Dyspnea on exertion (finding)",
      "exact": {
        "quantity": 1
      },
      "direct_transition": "OnsetHighOutputHF_Action_4"
    },
    "OnsetHighOutputHF_Action_4": {
      "type": "Symptom",
      "symptom": "Fatigue (finding)",
      "exact": {
        "quantity": 1
      },
      "direct_transition": "OnsetHighOutputHF_Action_5_Gate"
    },
    "OnsetHighOutputHF_Action_5_Gate": {
