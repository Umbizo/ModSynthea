    },
    "RCHOP_Cycle_Check": {
      "type": "Simple",
      "remarks": [
        "FIX: R-CHOP was a single instantaneous pass through all five drugs with",
        "no encounter class, no elapsed time, and no repetition -- one cycle,",
        "given once, at whatever instant Medical_Oncology_Encounter opened.",
        "Standard R-CHOP-21 is 6 cycles at 21-day intervals (~18 weeks total).",
        "This checks the just-incremented cycle count: at 6, treatment is",
        "complete and the module proceeds to response assessment; otherwise it",
        "waits out the rest of the 21-day cycle (already closed, above) before",
        "opening a new encounter for the next cycle."
      ],
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "dlbcl_rchop_cycle",
            "operator": ">=",
            "value": 6
          },
          "transition": "Interim_PET_CT"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "dlbcl_rchop_cycle",
            "operator": "<",
            "value": 6
          },
          "transition": "RCHOP_Cycle_Delay"
        }
      ]
    },
