{
  "name": "Endometrial Cancer Module",
  "remarks": [
    "Simulates endometrial cancer development, diagnosis, treatment, and surveillance",
    "Includes risk factors, staging, treatment pathways, and recurrence monitoring",
    "Models both early-stage and advanced disease with appropriate interventions"
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "InitializeCounters"
    },
    "InitializeCounters": {
      "type": "SetAttribute",
      "attribute": "surveillance_visits",
      "value": 0,
      "direct_transition": "InitializeRecurrenceCounter"
    },
    "InitializeRecurrenceCounter": {
      "type": "SetAttribute",
      "attribute": "years_no_recurrence",
      "value": 0,
      "direct_transition": "CheckRiskFactors"
    },
    "CheckRiskFactors": {
      "type": "Guard",
      "allow": {
        "condition_type": "And",
        "conditions": [
          {
            "condition_type": "Gender",
            "gender": "F"
          },
          {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 50,
            "unit": "years"
          },
          {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "obesity",
                "operator": "is not nil"
              },
              {
                "condition_type": "Attribute",
                "attribute": "diabetes",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "hypertension",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "nulliparous",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "tamoxifen_use",
                "operator": "==",
                "value": true
              }
            ]
          }
        ]
      },
      "direct_transition": "endometrial_cancer_Incidence_Gate"
    },
    "SymptomDevelopment": {
      "type": "Delay",
      "range": {
        "low": 0,
        "high": 2,
        "unit": "years"
      },
      "direct_transition": "PresentingSymptoms"
    },
    "PresentingSymptoms": {
      "type": "Simple",
      "direct_transition": "PresentingSymptoms_Action_1_Gate"
    },
    "PrimaryCareEvaluation": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185347001",
          "display": "Encounter for problem (procedure)"
        }
      ],
      "direct_transition": "TransvaginalUltrasound"
    },
    "TransvaginalUltrasound": {
      "type": "ImagingStudy",
      "procedure_code": {
        "system": "SNOMED-CT",
        "code": "429915000",
        "display": "Transvaginal ultrasonography of pelvis"
      },
      "series": [
        {
          "body_site": {
            "system": "SNOMED-CT",
            "code": "35039007",
            "display": "Uterus"
          },
          "modality": {
            "system": "DICOM-DCM",
            "code": "US",
            "display": "Ultrasound"
          },
          "instances": [
            {
              "title": "Transvaginal ultrasound",
              "sop_class": {
                "system": "DICOM-SOP",
                "code": "1.2.840.10008.5.1.4.1.1.6.1",
                "display": "Ultrasound Image Storage"
              }
            }
          ]
