    },
    "StartDonanemab": {
      "type": "MedicationOrder",
      "administration": true,
      "codes": [
        {
          "system": "RxNorm",
          "code": "2687966",
          "display": "donanemab"
        }
      ],
      "reason": "alzheimers_disease",
      "direct_transition": "InfusionProgram"
    },
