{
  "name": "Systemic Lupus Erythematosus (SLE)",
  "gmf_version": 2,
  "states": {
    "Initial": {
      "type": "Initial",
      "name": "Initial",
      "direct_transition": "Race_Ethnicity_Branch"
    },
    "Race_Ethnicity_Branch": {
      "type": "Simple",
      "name": "Race_Ethnicity_Branch",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "ethnicity",
            "operator": "==",
            "value": "hispanic"
          },
          "transition": "Set_Race_Hispanic"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "race",
            "operator": "==",
            "value": "black"
          },
          "transition": "Set_Race_Black"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "race",
            "operator": "==",
            "value": "asian"
          },
          "transition": "Set_Race_Asian"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "race",
            "operator": "==",
            "value": "native"
          },
          "transition": "Set_Race_Native"
        },
        {
          "condition": {
            "condition_type": "True"
          },
          "transition": "Set_Race_White"
        }
      ]
    },
    "Set_Race_Black": {
      "type": "SetAttribute",
      "name": "Set_Race_Black",
      "attribute": "sle_race_group",
      "value": "black",
